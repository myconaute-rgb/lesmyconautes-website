# Variables d'environnement — à configurer dans le dashboard Cloudflare Pages
# (Settings → Environment Variables, en cochant "Encrypt").
# Ne JAMAIS committer ce fichier avec des valeurs réelles.

# === Cloudflare Turnstile (Phase 1 — anti-bot formulaires) ===
# Site key : visible côté client dans le HTML (OK)
# Secret key : valider le token côté serveur (n8n webhook)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Webhook n8n contact (Phase 1) ===
# URL du webhook côté intendant_web :5001 (whitelist Flask, règle 6 SECURITE.md)
# Pas en direct vers n8n :5678
N8N_WEBHOOK_CONTACT_URL=

# === Email contact (Phase 1) ===
CONTACT_EMAIL_TO=myconautes@pm.me

# === Notes ===
# Les credentials Postgres et Telegram sont gérés côté n8n / .env serveur, jamais ici.
# Cf. https://developers.cloudflare.com/pages/configuration/build-configuration/#environment-variables
