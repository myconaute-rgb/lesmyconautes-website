# Headers HTTP — Cloudflare Pages
# Aligné sur règle 10 SECURITE.md (cohérence cross-domain avec Flask).
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https://api.lesmyconautes.fr; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Long cache pour les assets buildés (hash dans le nom)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo SVG : mid-cache (peut changer rarement)
/scaphandre-logo.svg
  Cache-Control: public, max-age=86400
