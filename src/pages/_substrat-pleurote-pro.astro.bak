---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import FAQItem from "../components/FAQItem.astro";
import HoneypotField from "../components/HoneypotField.astro";
import Turnstile from "../components/Turnstile.astro";
import ProductLd from "../components/seo/ProductLd.astro";
import FaqLd from "../components/seo/FaqLd.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";
import { FAQ_PLEUROTE } from "../data/faqs/substrat-pleurote-pro";
import { toLdItems } from "../data/faqs/_utils";
---

<BaseLayout
  title="Substrat pleurote professionnel bio — Ballots phase IV pour producteurs"
  description="Substrat pleurote bio phase IV — ballots stérilisés 2,5 kg, rendement 20-25 %, certifié AB FR-BIO-01. Producteur français, livraison frigo 1-3 jours. Grille tarifaire pro à venir."
>
  <PageHero
    theme="terracotta"
    label="Substrat pro · Vague 1"
    title="Substrat pleurote professionnel — Régularité documentée, prix HT/tonne transparent"
    highlight="prix HT/tonne transparent"
    description="Producteur français en circuit court 1-3 jours. Ballots stérilisés 2,5-2,7 kg en phase IV active, cycle court 7-12 jours, rendement 20-25 % stable, densité d'inoculation 2 % maîtrisée. Certifié AB FR-BIO-01."
    primaryCta={{ href: "#grille-pleurote", label: "Recevoir notre grille tarifaire pro" }}
    secondaryCta={{ href: "#devis-pleurote", label: "Demander un devis palette" }}
  />

  <ProductLd
    slug="substrat-pleurote-pro"
    name="Substrat de pleurote professionnel bio"
    description="Ballot de substrat colonisé en phase IV active pour culture professionnelle de pleurote (Pleurotus ostreatus). Stérilisé en autoclave, densité d'inoculation 2 % maîtrisée, souches sans spore Karabella et Purati, hybride exclusif eryngii × ostreatus. Certifié FR-BIO-01."
    image="/photos/agri-pleurote.jpg"
    latinName="Pleurotus ostreatus (pleurote en huître)"
    properties={[
      { name: "Phase à la livraison", value: "Phase IV active (prêt à fructifier)" },
      { name: "Conditionnement", value: "Sac unitaire 2,5 kg / demi-palette 200 kg / palette 500 kg" },
      { name: "Rendement constaté", value: "20-25 % du poids du substrat sur 2 à 3 volées" },
      { name: "Densité d'inoculation", value: "2 % (seuil bas testé : 0,5 %)" },
      { name: "Température fructification", value: "12-20 °C selon souche" },
      { name: "Hygrométrie primordia", value: "95 %" },
      { name: "Hygrométrie fructification", value: "70-90 %" },
      { name: "CO₂ max", value: "moins de 700 ppm" },
      { name: "Délai mise en culture → primordia", value: "7 à 12 jours" },
      { name: "Souches travaillées", value: "Karabella, Purati, hybride eryngii × ostreatus" },
      { name: "Transport", value: "Frigo 1 à 3 jours, France métropolitaine" },
    ]}
  />
  <FaqLd slug="substrat-pleurote-pro" items={toLdItems(FAQ_PLEUROTE)} />
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "Agriculteurs", url: "/agriculteurs" },
    { name: "Substrat pleurote pro" },
  ]} />

  <article class="bg-ivoire">
    <!-- H2 1 — Notre substrat pleurote — ce qu'il y a dans le ballot -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Le ballot</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Notre substrat pleurote — <em class="italic text-terracotta">ce qu'il y a dans le ballot</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Notre <strong>substrat pleurote professionnel</strong> est un ballot de 2,5 à 2,7 kg (max 2,8 kg), à base de sciure de bois et de céréales, <strong>stérilisé en autoclave</strong> puis ensemencé avec du mycélium de <em>Pleurotus ostreatus</em>. On l'incube chez nous 2 à 3 semaines selon la souche, puis on le livre en <strong>phase IV active</strong> — autrement dit ballot incubé prêt à fructifier dès la mise en culture.
          </p>
          <p>
            On parle ici de <em>pleurote en huître</em>, <em>pleurote grise</em>, des souches sans spore (Karabella et Purati), et d'un hybride exclusif eryngii × ostreatus. Pas de pleurote rose ni de pleurote jaune au catalogue — c'est une perspective, pas une dispo aujourd'hui. C'est notre format de référence pour le <strong>bloc substrat pleurote grise</strong> en production professionnelle. Un ballot mycélium phase 4, calibré, fabriqué et incubé chez nous.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 2 — Notre positionnement : substrat stérilisé, cycle court, autre technologie -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Notre positionnement</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Substrat stérilisé, cycle court, <em class="italic text-terracotta">autre technologie</em></h2>

        <blockquote class="mt-6 border-l-4 border-terracotta pl-5 py-3 italic text-brun font-display leading-relaxed">
          Notre substrat pleurote est produit en France, certifié AB FR-BIO-01, livré en phase IV active. C'est ce trio qu'aucun autre fournisseur ne propose en bloc.
        </blockquote>

        <blockquote class="mt-5 border-l-4 border-lavande pl-5 py-2 italic text-brun font-display leading-relaxed">
          On est beaucoup plus cher, on peut le dire directement. Ce n'est pas la même technologie. On fait du substrat stérilisé. On ne fait pas des blocs de 15 kg de substrat pasteurisé.
        </blockquote>

        <div class="mt-5 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Les grandes unités de production travaillent en blocs de 15 kg de substrat pasteurisé, pour des cycles de culture longs en grandes salles. C'est un autre métier, qui répond très bien à ses cibles — ce n'est simplement pas le nôtre. Nous, on propose un produit différent&nbsp;: ballot stérilisé en petit format, cycle court de 7 à 12 jours après mise en culture, planning précis, rotation rythmée.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 3 — Notre process : densité d'inoculation 2 % maîtrisée -->
    <section id="process" class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Notre process</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Densité d'inoculation 2 % — <em class="italic text-terracotta">notre seuil maîtrisé</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            On tourne autour de <strong>2 % d'inoculation</strong> en référence — c'est le maximum qu'on se permet sur la formule pleurote. En conditions optimales, on peut chercher à descendre pour économiser sur le mycélium grain, sans sacrifier le rendement. Notre seuil bas testé est <strong>0,5 %</strong> — au-dessous, on perd le contrôle, le démarrage devient erratique, le rendement décroche.
          </p>
          <p>
            Ce niveau de chiffrage technique est rare sur le marché — la plupart des fournisseurs ne le communiquent pas. On le partage parce que c'est exactement ce qui distingue un substrat <strong>fabriqué et incubé chez le producteur</strong> d'un substrat acheté à un courtier. Les ajustements de densité, on les fait nous-mêmes, sur nos propres lots, avec retour direct sur la fructification dans nos salles.
          </p>
        </div>

        <div class="mt-8 bg-creme rounded-2xl p-6 ring-1 ring-brun/5 space-y-3">
          <h3 class="text-base font-display text-brun">Stabilité du process</h3>
          <p class="text-sm text-brun-clair leading-relaxed">
            On contrôle l'incubation tout au long du cycle, on enlève les sacs contaminés avant expédition. Chaque écart est tracé, analysé, pris en compte sur le lot suivant.
          </p>
          <p class="text-sm text-brun-clair leading-relaxed">
            <span class="font-semibold text-brun">Un exemple concret —</span> il nous est arrivé de surincuber un lot de 2,5 semaines au-delà de la date prévue de mise en fructification. On l'avait considéré comme mort. Mis en culture, il a mis 3,5 semaines à se réveiller (au lieu des 7 à 12 jours en cycle normal). <strong>Et ça a poussé.</strong> Notre formule n'est pas calibrée pour ce genre d'écart, on ne le recommande pas — mais ça nous a appris la robustesse du mycélium en bonne santé. C'est le genre d'écart qui nourrit notre process.
          </p>
          <p class="text-sm text-brun-clair leading-relaxed">
            Vous recevez la sortie d'un process auto-corrigé en permanence.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 4 — Phase IV active -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Phase IV</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Phase IV — <em class="italic text-terracotta">ce que ça veut dire concrètement</em></h2>

        <blockquote class="mt-6 border-l-4 border-terracotta pl-5 py-3 italic text-brun font-display leading-relaxed">
          Le substrat est choqué en sortie d'incubation par le froid et fructifie directement après. Travailler avec des temps d'attente au frais plus longs n'a jamais montré de signes de rendement meilleur, au contraire : dégradation du substrat par le mycélium petit à petit.
        </blockquote>

        <div class="mt-5 space-y-4 text-brun-clair leading-relaxed">
          <p>
            La phase IV active, c'est un substrat colonisé à 100 %, sorti d'incubation, choqué par le froid du transport — il « comprend » que c'est le moment de fructifier. À l'arrivée, on le met en culture sans attendre&nbsp;: les premiers primordia apparaissent en 7 à 12 jours, et la première récolte suit dans les 3 à 5 jours.
          </p>
          <p>
            Pour un panorama plus pédagogique de la différence phase III / phase IV, on a ouvert une page tampon dédiée&nbsp;: <a href="/substrat-incube-pret-fructifier" class="underline hover:text-violet-profond">substrat incubé prêt à fructifier</a>.
          </p>
          <blockquote class="border-l-4 border-lavande pl-4 py-1 italic font-display text-brun leading-relaxed">
            En quelques jours de cycle de vie, un jour peut être long pour un champignon.
          </blockquote>
        </div>
      </div>
    </section>

    <!-- H2 5 — Rendement et nombre de volées -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Rendement</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Rendement et <em class="italic text-terracotta">nombre de volées</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            En production professionnelle sur cycles courts, le rendement est de <strong>20 à 25 % du poids du substrat</strong>, stable sur 2 à 3 volées. C'est notre référence. Il est techniquement possible d'aller plus haut — 30 à 35 % — en gardant les blocs plus longtemps, mais on bascule alors sur des champignons surcalibrés ou déformés, hors usage commercial. Notre métier vise la qualité régulière, pas le rendement maximal.
          </p>
        </div>

        <div class="mt-8 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-brun/10 text-left">
                <th class="py-3 pr-4 font-semibold text-brun">Paramètre fructification pleurote</th>
                <th class="py-3 font-semibold text-brun">Valeur</th>
              </tr>
            </thead>
            <tbody class="text-brun-clair">
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Température fructification</td>
                <td class="py-3 font-display text-brun">12–20 °C selon souche</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Hygrométrie phase primordia</td>
                <td class="py-3 font-display text-brun">95 %</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Hygrométrie phase fructification</td>
                <td class="py-3 font-display text-brun">70–90 %</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">CO<sub>2</sub> max</td>
                <td class="py-3 font-display text-brun">&lt; 700 ppm</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Brassage d'air</td>
                <td class="py-3 font-display text-brun">Continu, obligatoire</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Délai mise en culture → primordia</td>
                <td class="py-3 font-display text-brun">7–12 jours</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Délai primordia → récolte</td>
                <td class="py-3 font-display text-brun">3–5 jours</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Volées par ballot</td>
                <td class="py-3 font-display text-brun">2 à 3</td>
              </tr>
              <tr>
                <td class="py-3 pr-4">Durée de vie utile du ballot</td>
                <td class="py-3 font-display text-brun">7–8 semaines max</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- H2 6 — Variétés disponibles -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Notre gamme</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Variétés disponibles — <em class="italic text-terracotta">pleurote gris et hybride exclusif</em></h2>

        <h3 class="mt-6 text-lg font-display text-brun">Pleurote gris, en souches sans spore</h3>
        <div class="mt-3 space-y-4 text-brun-clair leading-relaxed">
          <p>
            On travaille principalement deux souches&nbsp;: <strong>Karabella</strong> (avec K) et <strong>Purati</strong>. Sélectionnées pour la production agricole et la vente, elles offrent un rendement élevé, des champignons réguliers et une conservation prolongée pour du pleurote frais (en jours dans des conditions moyennes, en petites semaines dans les meilleures).
          </p>
          <p>
            Le choix de souches sans spore répond à une exigence d'hygiène en salle (réduction des allergies, propreté de l'environnement de culture).
          </p>
        </div>

        <h3 class="mt-8 text-lg font-display text-brun">Notre hybride eryngii × ostreatus — un produit unique en France</h3>
        <p class="mt-3 text-sm text-brun-clair leading-relaxed">
          Croisement entre le pleurote du panicaut (eryngii) et un pleurote en huître. Rendement plus faible que le pleurote gris classique, mais morphologie et texture singulières — un produit d'attrait pour la cible gastro. Si vous travaillez l'eryngii pur en parallèle, voir aussi notre <a href="/substrat-eryngii-panicaut" class="underline hover:text-violet-profond">page substrat eryngii</a>.
        </p>

        <div class="mt-6 bg-ivoire rounded-2xl p-5 ring-1 ring-brun/5">
          <p class="text-xs uppercase tracking-wider text-brun-clair/70">Variétés non encore au catalogue</p>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed">
            Pleurote rose, pleurote jaune. Une introduction est envisagée à terme. Notre orientation actuelle privilégie la profondeur sur le pleurote gris — plusieurs souches travaillées, optimisées pour des productrices et producteurs qui doivent vivre de leur production.
          </p>
        </div>

        <p class="mt-6 text-sm text-brun-clair leading-relaxed">
          Pour la culture du <strong>hericium en pro</strong> (production saisonnière), voir notre <a href="/substrat-hericium-pro" class="underline hover:text-violet-profond">substrat hericium pro</a> — méthode propriétaire d'entaille latérale, paramètres calibrés à 95/90/80–85 %.
        </p>
      </div>
    </section>

    <!-- H2 7 — Pour qui — 3 profils, 3 raisons de commander chez nous -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Pour qui</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">3 profils, <em class="italic text-terracotta">3 raisons de commander chez nous</em></h2>

        <div class="mt-6 grid md:grid-cols-3 gap-5">
          <div class="bg-creme rounded-2xl p-6 ring-1 ring-brun/5">
            <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Profil 1</span>
            <h3 class="mt-2 text-base font-display text-brun">Productrice ou producteur établi en diversification</h3>
            <p class="mt-3 text-sm text-brun-clair leading-relaxed">
              Vous fournissez déjà des marchés en légumes ou autres productions, et vous voulez compléter par quelques caisses de pleurote pour étoffer votre étal — particulièrement en période creuse des autres cultures. Volume modeste mais régulier, rotation hebdomadaire ou bi-hebdomadaire.
            </p>
          </div>

          <div class="bg-creme rounded-2xl p-6 ring-1 ring-brun/5">
            <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Profil 2</span>
            <h3 class="mt-2 text-base font-display text-brun">Porteuse ou porteur de projet champignonnière</h3>
            <p class="mt-3 text-sm text-brun-clair leading-relaxed">
              Vous voulez monter une champignonnière de zéro. Vous avez besoin de tester avant d'investir, de démarcher vos futurs clients avec un produit fini en main, de valider une idée. Volume unitaire au démarrage, palette ensuite quand le marché est validé.
            </p>
            <p class="mt-4 text-sm text-brun font-semibold">Notre conseil concret avant de se lancer&nbsp;:</p>
            <blockquote class="mt-2 border-l-4 border-terracotta pl-4 py-1 italic font-display text-brun text-sm leading-relaxed">
              Je fais surtout une bonne étude de marché autour de chez moi. Quand on n'a pas envie de le faire et qu'on ne le fait pas, on avance quand même, mais ça ne se finit pas terriblement.
            </blockquote>
          </div>

          <div class="bg-creme rounded-2xl p-6 ring-1 ring-brun/5">
            <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Profil 3</span>
            <h3 class="mt-2 text-base font-display text-brun">Agricultrice ou agriculteur en diversification</h3>
            <p class="mt-3 text-sm text-brun-clair leading-relaxed">
              Vous voulez tester un nouveau produit dans vos canaux de vente existants — AMAP, maraîchage, vente directe à la ferme. Volume demi-palette ou palette selon l'expérimentation, calé sur votre saisonnalité.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- H2 8 — Producteur français — circuit court -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Producteur français</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Circuit court 1 à 3 jours <em class="italic text-terracotta">vs import</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            On fabrique le substrat dans notre atelier de Rive-de-Gier (Loire), avec des matières premières sourcées en local. <strong>Le transport ne dure que 1 à 2, maximum 3 jours</strong> en frigo France métropolitaine. Le substrat ne souffre pas du transport — au contraire, le froid déclenche la fructification dès l'arrivée chez vous.
          </p>
          <p>
            Notre choix&nbsp;: circuit court français. Producteur direct, sans intermédiaire, livraison en 1 à 3 jours par transport frigorifique. Un substrat importé de Belgique, d'Allemagne ou d'Asie traverse plus de kilomètres et passe par plus d'étapes — c'est une autre logistique, qui répond à d'autres modèles économiques. Notre approche, à nous, c'est la proximité&nbsp;: on récolte le mycélium en phase IV active, on l'expédie sous 24 à 72 heures, vous le recevez prêt à fructifier.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 9 — Pourquoi le cycle court protège votre culture -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Cycle court</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Pourquoi le cycle court <em class="italic text-terracotta">protège votre culture</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Le cycle court n'est pas qu'une question de planning&nbsp;: c'est aussi un avantage hygiénique structurel. Pendant la phase d'incubation chez nous, le ballot stérilisé reste fermé — le mycélium se développe à l'abri des contaminants ambiants pendant sa période la plus sensible. Une fois en fructification chez vous, la durée courte (7 à 8 semaines maximum) limite naturellement la fenêtre pendant laquelle acariens, moucherons ou moisissures pourraient s'installer durablement dans votre salle.
          </p>
          <p>
            Concrètement&nbsp;: c'est précieux pour les <strong>porteurs de projet</strong> qui démarrent en cave humide ou dans un local pas entièrement maîtrisé. <strong>Vous gagnez en marge hygiénique sans avoir à investir d'emblée dans un environnement parfaitement contrôlé.</strong> Le ballot fermé pendant l'incubation isole le mycélium, et la rotation rapide en salle laisse moins de temps aux nuisibles pour s'installer — deux protections qui se cumulent.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 10 — Conditionnement, palette, livraison -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Commande</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Conditionnement, <em class="italic text-terracotta">palette, livraison</em></h2>

        <div class="mt-6 grid sm:grid-cols-3 gap-4">
          <div class="bg-ivoire rounded-2xl p-5 ring-1 ring-brun/5 text-center">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Sac unitaire</div>
            <div class="font-display text-2xl text-brun mt-1">2,5 kg</div>
            <p class="text-xs text-brun-clair mt-2">Test ou complément de volume.</p>
          </div>
          <div class="bg-ivoire rounded-2xl p-5 ring-1 ring-brun/5 text-center">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Demi-palette</div>
            <div class="font-display text-2xl text-brun mt-1">200 kg</div>
            <p class="text-xs text-brun-clair mt-2">Production régulière à petite échelle.</p>
          </div>
          <div class="bg-ivoire rounded-2xl p-5 ring-1 ring-brun/5 text-center">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Palette</div>
            <div class="font-display text-2xl text-brun mt-1">500 kg</div>
            <p class="text-xs text-brun-clair mt-2">Production professionnelle, meilleur tarif unitaire.</p>
          </div>
        </div>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Transport frigorifique géré par nos soins (transporteur partenaire, frais répercutés sur la facture selon les départements) ou via votre propre transporteur si vous en avez un. Une <strong>page explicative</strong> simple et opérationnelle accompagne chaque commande individuelle, pour qu'elle soit transmissible aux nouvelles générations qu'on aimerait voir s'intéresser à la culture du champignon.
          </p>
          <p>
            <strong>Acheter du substrat pleurote bio en gros</strong>&nbsp;? Le devis personnalisé palette vous donne la grille HT/tonne adaptée à votre volume. Une grille tarifaire publique téléchargeable est mise à disposition pour les pros — fiche en cours d'actualisation.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 — Grille tarifaire pro (lead magnet) -->
    <section id="grille-pleurote" class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Grille tarifaire</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Grille tarifaire pro — <em class="italic text-terracotta">prix HT/tonne transparent</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Notre grille tarifaire pro est en finalisation. Elle couvre les volumes <strong>demi-palette (200 kg)</strong> et <strong>palette (500 kg)</strong> avec prix HT/tonne, formats sac unitaire pour test, et délais de livraison France métropolitaine.
          </p>
          <p>
            Recevez-la directement quand elle sera publiée. Laissez-nous votre nom, votre email, la variété qui vous intéresse et un volume estimé — on vous l'envoie dès qu'elle est prête, et on prend en compte votre profil pour la version qu'on vous transmet.
          </p>
        </div>

        <form class="mt-8 grid gap-4 bg-creme rounded-2xl p-8 ring-1 ring-brun/5" data-grille-form>
          <HoneypotField />
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="gp-name" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Nom *</label>
              <input id="gp-name" name="name" type="text" required class="w-full px-4 py-3 rounded-xl bg-ivoire border-2 border-brun/10 focus:border-terracotta focus:outline-none text-sm" />
            </div>
            <div>
              <label for="gp-email" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Email *</label>
              <input id="gp-email" name="email" type="email" required class="w-full px-4 py-3 rounded-xl bg-ivoire border-2 border-brun/10 focus:border-terracotta focus:outline-none text-sm" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-2">Variété(s) d'intérêt *</label>
            <div class="grid sm:grid-cols-2 gap-2">
              <label class="flex items-center gap-2 text-sm text-brun-clair px-3 py-2 rounded-xl bg-ivoire border-2 border-brun/10 hover:border-terracotta cursor-pointer">
                <input type="checkbox" name="varietes" value="pleurote_gris" class="accent-terracotta" />
                <span>Pleurote gris (Karabella, Purati)</span>
              </label>
              <label class="flex items-center gap-2 text-sm text-brun-clair px-3 py-2 rounded-xl bg-ivoire border-2 border-brun/10 hover:border-terracotta cursor-pointer">
                <input type="checkbox" name="varietes" value="hybride" class="accent-terracotta" />
                <span>Hybride eryngii × ostreatus</span>
              </label>
              <label class="flex items-center gap-2 text-sm text-brun-clair px-3 py-2 rounded-xl bg-ivoire border-2 border-brun/10 hover:border-terracotta cursor-pointer">
                <input type="checkbox" name="varietes" value="eryngii" class="accent-terracotta" />
                <span>Eryngii (pleurote du panicaut)</span>
              </label>
              <label class="flex items-center gap-2 text-sm text-brun-clair px-3 py-2 rounded-xl bg-ivoire border-2 border-brun/10 hover:border-terracotta cursor-pointer">
                <input type="checkbox" name="varietes" value="hericium" class="accent-terracotta" />
                <span>Hericium (saisonnier)</span>
              </label>
            </div>
          </div>
          <div>
            <label for="gp-volume" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Volume estimé</label>
            <select id="gp-volume" name="volume" class="w-full px-4 py-3 rounded-xl bg-ivoire border-2 border-brun/10 focus:border-terracotta focus:outline-none text-sm">
              <option value="">— Sélectionnez —</option>
              <option value="sac_unitaire">Sac unitaire (test)</option>
              <option value="demi_palette_200kg">Demi-palette 200 kg</option>
              <option value="palette_500kg">Palette 500 kg</option>
              <option value="plus_500kg">Plus de 500 kg</option>
              <option value="ne_sait_pas">Je ne sais pas encore</option>
            </select>
          </div>
          <Turnstile />
          <button type="submit" class="justify-self-start inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brun text-ivoire font-semibold hover:brightness-110 transition shadow-sm">
            Recevoir la grille dès publication →
          </button>
          <p class="text-xs text-brun-clair/70 leading-relaxed">
            En envoyant ce formulaire, vous acceptez que vos données (nom, email, variété, volume) soient utilisées pour vous transmettre la grille tarifaire et un éventuel suivi commercial. <a href="/mentions-legales" class="underline hover:text-violet-profond">Plus d'infos</a>.
          </p>
          <p class="hidden text-sm text-turquoise font-semibold" data-form-success>
            Merci, votre demande est partie. On vous envoie la grille dès qu'elle est prête.
          </p>
          <p class="hidden text-sm text-terracotta font-semibold" data-form-error>
            Une erreur est survenue. Réessayez, ou écrivez directement à <span class="underline">myconaute &#x40; pm.me</span>.
          </p>
        </form>
      </div>
    </section>

    <!-- H2 11 — Certification AB FR-BIO-01 — produits transmissibles en AB à vos clients -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Certification</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Certification AB FR-BIO-01 — <em class="italic text-terracotta">produits transmissibles en AB à vos clients</em></h2>

        <blockquote class="mt-6 border-l-4 border-terracotta pl-5 py-3 italic text-brun font-display leading-relaxed">
          Toute notre matière première est tracée dans les audits BIO avec le cahier des charges BIO. On peut vendre avec un certificat BIO. Et comme ça, les produits qui découlent de notre produit peuvent être vendus en AB par nos clients.
        </blockquote>

        <div class="mt-5 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Concrètement, <strong>substrat pleurote AB certifié</strong> = vos champignons pourront être vendus en AB sans recharge administrative. Notre certificat (Ecocert, n° FR-BIO-01.250-0043443.2026.003) couvre la totalité du cycle, de la matière première à l'expédition.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 12 — Cas client : la confusion variété -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Cas client</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Cas client — <em class="italic text-terracotta">la confusion de variété</em></h2>

        <blockquote class="mt-6 border-l-4 border-terracotta pl-5 py-3 italic text-brun font-display leading-relaxed">
          Au début de notre production, on s'est trompé : on a envoyé une variété de pleurote à la place d'une autre variété de pleurote à un client. C'était un pleurote beaucoup plus foncé. On l'a indemnisé. Et en tout cas, depuis, il ne commande que cette variété plus foncée. Comme quoi, parfois, la peur de la nouveauté peut mettre des freins inutiles.
        </blockquote>

        <div class="mt-5 space-y-4 text-brun-clair leading-relaxed">
          <p>
            On raconte cette histoire telle quelle parce qu'elle dit deux choses qui comptent. La première&nbsp;: quand on se trompe, on indemnise — pas de SAV qui se cache derrière des conditions générales. La seconde&nbsp;: les variétés moins connues du pleurote gris peuvent ouvrir des débouchés inattendus, à condition de leur donner leur chance.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 13 — FAQ pros -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">FAQ</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Questions <em class="italic text-terracotta">fréquentes pros</em></h2>

        <div class="mt-6">
          {FAQ_PLEUROTE.map((item) => (
            <FAQItem question={item.question}>
              <Fragment set:html={item.answerHtml} />
            </FAQItem>
          ))}
        </div>
      </div>
    </section>

    <!-- Section devis -->
    <section id="devis-pleurote" class="bg-ivoire px-6 py-16">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Devis substrat pleurote pro</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Demandez un <em class="italic text-terracotta">devis palette</em></h2>
        <p class="mt-4 text-brun-clair leading-relaxed max-w-xl mx-auto">
          Indiquez votre volume cible, votre fréquence, et votre profil (production en cours, projet, diversification). Réponse rapide, devis adapté, grille tarifaire transmise.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/agriculteurs#contact-agri"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brun text-ivoire font-semibold hover:brightness-110 transition shadow-sm"
          >
            Demander un devis palette <span aria-hidden="true">→</span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-brun/30 text-brun font-semibold hover:bg-brun/5 transition"
          >
            Nous écrire
          </a>
        </div>
        <p class="mt-6 text-xs text-brun-clair/70">
          Pour un essai unitaire avant de commander une palette, possible via <a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class="underline hover:text-brun">notre boutique Pour de Bon</a>.
        </p>
      </div>
    </section>
  </article>

  <CTASection
    title="Une question avant d'engager une palette ?"
    description="On répond directement — par mail, téléphone, ou de visu sur place à Rive-de-Gier."
    primaryCta={{ href: "/contact", label: "Nous écrire" }}
    secondaryCta={{ href: "/agriculteurs", label: "Voir tous nos substrats" }}
  />
</BaseLayout>

<script>
  import { wireContactForm } from "../scripts/contact-form";
  const form = document.querySelector<HTMLFormElement>("[data-grille-form]");
  if (form) wireContactForm(form, "grille_tarifaire_pleurote");
</script>
