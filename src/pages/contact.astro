---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../components/ContactSection.astro";
import CTASection from "../components/CTASection.astro";
import MailLink from "../components/MailLink.astro";
import LocalBusinessLd from "../components/seo/LocalBusinessLd.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";
import envieGouterPic from "../assets/photos/envie-gouter.jpg";
---

<BaseLayout
  title="Contact — Les Myconautes | Champignonnière bio Rive-de-Gier"
  description="Une question, un devis, une visite ? Écrivez-nous. Champignonnière artisanale FR-BIO-01 à Rive-de-Gier (Loire), entre Lyon et Saint-Étienne."
  skin="refonte"
>
  <LocalBusinessLd />
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "Contact" },
  ]} />

  <div class="bg-page font-body text-brun">
    <ContactSection
      formType="contact"
      messageRequired={true}
      scriptTone="violet"
      headingLevel="h1"
      intro="Que ce soit pour partager une recette, obtenir nos tarifs & conditions de vente, demander des détails techniques sur nos substrats ou nous avouer que vous adorez nos champignons … on vous réponds !"
    >
      <Fragment slot="consent">
        Vos données (nom, email, téléphone, code postal, message) sont traitées uniquement pour répondre à votre demande, conservées 3 ans après le dernier échange, et ne sont transmises à aucun tiers commercial. Vos droits (accès, rectification, effacement, opposition) s'exercent à <MailLink email="rgpd@lesmyconautes.fr" class="underline hover:text-violet" />. <a href="/politique-confidentialite" class="underline hover:text-violet">Détails</a>.
      </Fragment>
    </ContactSection>

    <CTASection
      variant="editorial"
      title="Envie de goûter ?"
      description="Passez-nous commande directement via Pour de Bon, ou contactez-nous pour les volumes pro."
      image={envieGouterPic}
      imageAlt="Dégustation de champignons poêlés"
      primaryCta={{ href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander en ligne" }}
      secondaryCta={{ href: "#contact", label: "Nous écrire" }}
    />
  </div>
</BaseLayout>
