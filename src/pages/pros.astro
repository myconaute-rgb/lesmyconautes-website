---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GammeSection from "../components/GammeSection.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import DeliveryGrid from "../components/DeliveryGrid.astro";
import FaqCommune from "../components/FaqCommune.astro";
import ContactSection from "../components/ContactSection.astro";
import CTASection from "../components/CTASection.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";

import heroBandPic from "../assets/photos/bandeau-eryngii.jpg";
import envieGouterPic from "../assets/photos/envie-gouter.jpg";


const AVANTAGES = [
  { icon: "bio", title: "100% bio certifié", text: "Label FR-BIO-01. Cultivés sans pesticide, gestion raisonnée de l'eau et des emballages." },
  { icon: "conditionnement", title: "Conditionnement pro", text: "Vrac ou conditionnement adapté. Caissettes, colis — on s'adapte à votre flux." },
  { icon: "volumes", title: "volumes réguliers", text: "Production maîtrisée toute l'année. Qualité constante, logistique fiable, livraison sous 48h." },
  { icon: "livraison", title: "livraison directe", text: "Tournées Lyon (vendredi) et Saint-Étienne (jeudi). France entière via Pour de Bon." },
  { icon: "circuit", title: "circuit court", text: "Cultivés, récoltés et conditionnés à Rive-de-Gier. Zéro intermédiaire, traçabilité totale." },
  { icon: "tarifs", title: "tarifs pro", text: "Grille tarifaire et conditions de vente sur demande, dégressifs selon les volumes." },
] as const;

/* Pictos des conseils : jeu HD d'Aline (v5 du 29/07) — température, humidité (atmosphère),
   tempo (durée), congélation — présentés dans des ronds violets. */
const CONSEILS = [
  { icon: "temperature", title: "Température idéale", text: "1 à 2°C en chambre froide pour stopper le développement et optimiser le temps de conservation de nos champignons." },
  { icon: "humidite", title: "Atmosphère", text: "Atmosphère humide et propre en chambre froide pour prévenir la déshydratation. Ne jamais arroser directement." },
  { icon: "duree", title: "Durée", text: "8 à 10 jours au réfrigérateur dans l'emballage d'origine. Livrés propres et parés, aucun lavage nécessaire." },
  { icon: "congelation", title: "Congélation", text: "Poêlez légèrement avant congélation pour préserver texture et goût. Idéal pour vos préparations à l'avance." },
] as const;
---

<BaseLayout
  title="Champignons bio frais Lyon &amp; Saint-Étienne pour restauration | Les Myconautes"
  description="Champignon frais bio pour cheffes et chefs : pleurote, éryngii, hericium, Black Pearl. Livraison directe Lyon (vendredi) et Saint-Étienne (jeudi). Certifié FR-BIO-01, qualité constante toute l'année. Grille pro sur demande."
  skin="refonte"
>
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "Pros" },
  ]} />

  <div class="bg-page font-body text-brun">
    <!-- Hero cacao -->
    <section class="bg-page">
      <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 md:pt-14 pb-8">
        <h1 class="font-title text-[clamp(2.4rem,6.5vw,5.5rem)] leading-[0.98] text-cacao">
          Des champignons bio <em class="italic">d'exception</em>
        </h1>
      </div>
      <div class="relative h-64 md:h-96 bg-cacao overflow-hidden">
        <Image src={heroBandPic} alt="Cagette d'eryngii fraîchement récoltés — Les Myconautes" loading="eager" decoding="async" widths={[640,960,1280,1600]} sizes="100vw" formats={["avif","webp"]} class="w-full h-full object-cover" />
      </div>
      <div class="max-w-7xl mx-auto px-6 md:px-10 py-10">
        <div class="max-w-3xl text-brun leading-relaxed space-y-4">
          <p>Restauration, distribution, épicerie fine, AMAP : une gamme complète, des volumes réguliers, une qualité constante, toute l'année.</p>
          <p>Cultivés pour les palais exigeants, nos champignons sont récoltés chaque jour, et livrés sous 48h. En vrac ou dans différents conditionnements adapté aux circuits professionnels.</p>
          <p>Un résultat magnifique en Cuisine : propres et parés, aucun lavage nécessaire et très peu de réduction à la cuisson.</p>
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="#contact" class="inline-flex items-center px-8 py-4 rounded-btn bg-cacao text-page text-sm font-semibold tracking-wide uppercase hover:bg-cacao/90 transition-colors">Demander nos tarifs</a>
          <a href="#gamme" class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-cacao text-cacao text-sm font-semibold tracking-wide uppercase hover:bg-cacao/10 transition-colors">Découvrir notre gamme</a>
        </div>
      </div>
    </section>

    <GammeSection id="gamme" titleTone="cacao" scriptTone="violet" />

    <!-- Avantages : 6 bulles violettes -->
    <section class="px-6 md:px-10 py-14 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-cacao">Un <em class="italic">partenaire</em> fiable pour vos approvisionnements</h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-violet">pourquoi nous choisir ?</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {AVANTAGES.map((a) => (
            <div class="text-center">
              <FeatureIcon name={a.icon} />
              <h3 class="mt-4 font-title text-lg text-cacao">{a.title}</h3>
              <p class="mt-2 text-sm text-brun leading-relaxed max-w-xs mx-auto">{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Livraison -->
    <section class="px-6 md:px-10 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <DeliveryGrid variant="editorial" deliveryPrice="3,50€" />
      </div>
    </section>

    <!-- Conseils conservation : 4 bulles carrées -->
    <section class="px-6 md:px-10 py-14 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-cacao">Conservation &amp; utilisation</h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-violet">conseils pro</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-10 gap-y-10 max-w-4xl">
          {CONSEILS.map((c) => (
            <div class="flex gap-5">
              <FeatureIcon name={c.icon} shape="circle" size="md" />
              <div>
                <h3 class="font-title text-lg text-cacao">{c.title}</h3>
                <p class="mt-1 text-sm text-brun leading-relaxed">{c.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FaqCommune titleTone="cacao" scriptTone="violet" />

    <ContactSection
      formType="contact_pro"
      messageRequired={false}
      scriptTone="violet"
      intro="Vous souhaitez obtenir plus d'information sur nos tarifs & conditions de vente ? Laissez nous votre message, on vous rappelle !"
    />

    <CTASection
      variant="editorial"
      title="Envie de goûter ?"
      description="Contactez-nous pour passer commande ou RDV directement sur Pour de Bon PRO."
      image={envieGouterPic}
      imageAlt="Dégustation de champignons poêlés"
      primaryCta={{ href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander en ligne" }}
      secondaryCta={{ href: "#contact", label: "Nous écrire" }}
    />
  </div>
</BaseLayout>
