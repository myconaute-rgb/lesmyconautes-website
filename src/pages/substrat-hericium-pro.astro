---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import FAQItem from "../components/FAQItem.astro";
import ProductLd from "../components/seo/ProductLd.astro";
import FaqLd from "../components/seo/FaqLd.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";
import { FAQ_HERICIUM } from "../data/faqs/substrat-hericium-pro";
import { toLdItems } from "../data/faqs/_utils";
---

<BaseLayout
  title="Substrat hericium professionnel — Mycélium lion's mane culture"
  description="Substrat hericium pro pour myciculteurs et chefs gastronomiques — méthode entaille latérale, ballot 2,5-2,7 kg, rendement 20-25 %. Production saisonnière, prochaine campagne sur inscription."
>
  <PageHero
    theme="lavande"
    label="Substrat pro · Vague 1"
    title="Substrat hericium professionnel — Crinière de lion en mycélium phase IV"
    highlight="Crinière de lion"
    description="Champignon de myciculteur expérimenté. On vous livre un substrat en phase IV active calibré, avec notre méthode propriétaire d'entaille latérale qui force la fructification en cascade. Production saisonnière — inscrivez-vous pour la prochaine campagne."
    primaryCta={{ href: "#interet-hericium", label: "Être prévenu·e — prochaine campagne" }}
    secondaryCta={{ href: "#methode", label: "Voir notre méthode" }}
  />

  <ProductLd
    slug="substrat-hericium-pro"
    name="Substrat de hericium professionnel bio"
    description="Ballot de substrat colonisé en phase IV active pour culture professionnelle de hericium (Hericium erinaceus, crinière de lion). Stérilisé en autoclave, méthode propriétaire d'entaille latérale et fructification en cascade. Production saisonnière, certifié FR-BIO-01."
    image="/photos/agri-hericium.jpg"
    latinName="Hericium erinaceus (crinière de lion)"
    properties={[
      { name: "Phase à la livraison", value: "Phase IV active (prêt à fructifier)" },
      { name: "Conditionnement", value: "Ballot 2,5-2,7 kg / demi-palette / palette" },
      { name: "Rendement constaté", value: "20-25 % du poids du substrat sur 2 à 3 volées" },
      { name: "Température fructification", value: "18 °C" },
      { name: "Hygrométrie primordia", value: "supérieure à 95 %" },
      { name: "Hygrométrie fructification", value: "supérieure à 90 %" },
      { name: "Méthode propriétaire", value: "Entaille latérale + inclinaison en cascade" },
      { name: "Disponibilité", value: "Saisonnière (sur inscription pour la prochaine campagne)" },
    ]}
  />
  <FaqLd slug="substrat-hericium-pro" items={toLdItems(FAQ_HERICIUM)} />
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "Agriculteurs", url: "/agriculteurs" },
    { name: "Substrat hericium pro" },
  ]} />

  <article class="bg-ivoire">
    <!-- Bandeau dispo -->
    <section class="bg-creme px-6 py-6 border-b border-brun/5">
      <div class="max-w-3xl mx-auto space-y-3">
        <div class="flex items-start gap-4">
          <span class="flex-shrink-0 mt-0.5 inline-block w-3 h-3 rounded-full bg-lavande"></span>
          <p class="text-sm text-brun-clair leading-relaxed">
            <strong class="text-brun">Disponibilité saisonnière —</strong> le hericium est un champignon de culture chaude. Notre production se concentre sur la saison adaptée. <a href="#interet-hericium" class="underline hover:text-violet-profond">Inscrivez-vous</a> pour être prévenu·e de la réouverture de campagne, ou <a href="/agriculteurs#contact-agri" class="underline hover:text-violet-profond">demandez un devis pro</a> pour une livraison sur la prochaine fenêtre. <strong class="text-brun">En attendant la prochaine campagne, voyez aussi notre <a href="/substrat-pleurote-pro" class="underline hover:text-violet-profond">substrat pleurote pro</a>, notre <a href="/substrat-eryngii-panicaut" class="underline hover:text-violet-profond">substrat eryngii</a>, et la pédagogie de la <a href="/substrat-incube-pret-fructifier" class="underline hover:text-violet-profond">phase IV active</a> qui s'applique à toutes nos productions.</strong>
          </p>
        </div>
        <p class="text-xs text-brun-clair/80 leading-relaxed pl-7">
          Une question technique avant de commander ? On répond directement — on teste nos lots, on connaît leurs comportements en salle de culture.
        </p>
      </div>
    </section>

    <!-- H2 1 — Pourquoi le hericium est différent -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Producteur français</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Pourquoi le hericium est <em class="italic text-violet-profond">différent</em> — et exigeant</h2>

        <blockquote class="mt-6 border-l-4 border-lavande pl-5 py-3 italic text-brun font-display leading-relaxed">
          Le substrat hericium qu'on produit en France, sous certification AB FR-BIO-01, arrive chez vous en phase IV active : sortie d'incubation, contrôle qualité fait, prêt pour la fructification.
        </blockquote>

        <p class="mt-5 text-brun-clair leading-relaxed">
          Voilà ce qu'il y a en bref — maintenant entrons dans le concret de ce que c'est, ce champignon qu'on aime travailler et qu'on ne brade pas.
        </p>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Le hericium — <em>Hericium erinaceus</em>, aussi appelé <strong>crinière de lion</strong>, hydne hérisson, pom pom blanc, ou yamabushitake en japonais — est un champignon de myciculteur expérimenté. Il ne pardonne pas. Un mauvais réglage climatique de quelques heures peut tuer le bloc, là où un pleurote pardonnerait sans broncher.
          </p>

          <div class="bg-creme rounded-2xl p-5 ring-1 ring-brun/5">
            <p class="text-xs uppercase tracking-wider text-brun-clair/70 mb-2">Aussi connu sous le nom de</p>
            <p class="text-sm text-brun-clair leading-relaxed">crinière de lion · hydne hérisson · <em>Hericium erinaceus</em> · pom pom blanc · yamabushitake (山伏茸)</p>
          </div>

          <p>
            Producteur français spécialisé dans la culture professionnelle, on a fait le choix de ne pas brader la difficulté&nbsp;: notre <strong>substrat hericium professionnel</strong> est calibré pour des conditions de fructification précises, livré en phase IV active pour vous éviter la phase d'incubation (la plus risquée du cycle).
          </p>

          <blockquote class="border-l-4 border-violet-profond pl-5 py-2 italic text-brun font-display leading-relaxed">
            On ne produit que du champignon frais. On en fait sécher si besoin. Mais ce qu'on aime chez nous, c'est le champignon en lui-même.
          </blockquote>

          <p>
            On précise pour lever toute ambiguïté&nbsp;: cette page concerne la <strong>culture professionnelle</strong> du hericium — substrat, ballot, fructification, rendement par myciculteur. Pour les usages médicinaux ou les compléments alimentaires en gélule, votre médecin reste l'interlocuteur compétent. Notre métier, c'est le carpophore frais.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 2 — Notre méthode propriétaire de mise en fructification -->
    <section id="methode" class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Notre méthode</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Notre méthode propriétaire de <em class="italic text-violet-profond">mise en fructification</em></h2>

        <blockquote class="mt-6 border-l-4 border-terracotta pl-5 py-3 italic text-brun font-display leading-relaxed">
          Notre méthode d'entaille latérale et d'inclinaison en cascade n'est pas une astuce de débutant — c'est le résultat de plusieurs saisons de comparaison entre les deux approches courantes en culture professionnelle.
        </blockquote>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Sur le hericium, la méthode d'ouverture du sac change tout. On a testé chez nous les deux approches.
          </p>
        </div>

        <div class="mt-6 grid md:grid-cols-2 gap-5">
          <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5">
            <h3 class="text-base font-display text-brun">Ouverture totale du sac (méthode courante)</h3>
            <p class="mt-3 text-sm text-brun-clair leading-relaxed">
              On voit beaucoup de jolies photos sur internet. Chez nous, le rendement est moins bon&nbsp;: la croissance se disperse sur toute la surface, le carpophore ne se densifie pas, certaines pousses échouent.
            </p>
          </div>
          <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5">
            <h3 class="text-base font-display text-brun">Notre méthode propriétaire&nbsp;: vider l'air, puis entailler sur un côté</h3>
            <p class="mt-3 text-sm text-brun-clair leading-relaxed">
              On expulse l'air du sac et on pratique une entaille sur l'un des côtés. Le champignon « voit » l'oxygène disponible à un endroit précis et y force la fructification de primordia. Densité de pousse bien meilleure, rendement plus régulier.
            </p>
          </div>
        </div>

        <div class="mt-6 bg-creme rounded-2xl p-5 ring-1 ring-brun/5">
          <p class="text-sm text-brun-clair leading-relaxed">
            <span class="font-semibold text-brun">💡 Pourquoi on partage cette méthode au lieu de la garder secrète&nbsp;?</span> Parce qu'elle ne fonctionne qu'avec un substrat calibré pour elle — formule, souche, hygrométrie de la salle. Vous pouvez la reproduire avec n'importe quel ballot, vous n'aurez pas le même résultat. Le savoir-faire propriétaire, c'est l'ensemble&nbsp;: substrat + méthode + paramètres.
          </p>
        </div>

        <h3 class="mt-10 text-lg font-display text-brun">Le hericium est un champignon de gravité — incliner les ballots</h3>
        <div class="mt-3 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Faire pousser un hericium à plat sur le dessus d'un bloc, c'est se battre contre sa biologie. Le champignon est conçu pour la <strong>cascade</strong>&nbsp;: la gravité entraîne les hydnes (les épines) vers le bas et leur donne leur forme caractéristique de fontaine renversée.
          </p>
          <p>
            Notre conseil&nbsp;: <strong>incliner le ballot</strong> en salle de culture, entaille sur le côté tournée vers le bas. Le champignon pousse en cascade, le carpophore prend toute sa morphologie, et le calibrage devient possible — ce que cherchent producteurs et myciculteurs en gamme premium.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 3 — Nos ballots de substrat hericium -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Caractéristiques</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Nos ballots de <em class="italic text-violet-profond">substrat hericium</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Format ballot 2,5 à 2,7 kg, dimensions 20 à 25 cm de large, ~15 cm de profondeur, 15 à 20 cm de haut. Substrat <strong>stérilisé à l'autoclave</strong> (pas pasteurisé), inoculé avec deux souches de hericium qui donnent des résultats similaires — carpophores denses, capables de grossir de manière impressionnante sur 2 à 3 volées. C'est le même produit qu'on utilise nous-mêmes en culture, et qu'on vend aux producteurs et productrices qui veulent travailler la crinière de lion en pro.
          </p>
        </div>

        <div class="mt-8 grid sm:grid-cols-2 gap-4">
          <div class="bg-creme rounded-2xl p-5 ring-1 ring-brun/5">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Poids ballot</div>
            <div class="font-display text-2xl text-brun mt-1">2,5–2,7 kg</div>
          </div>
          <div class="bg-creme rounded-2xl p-5 ring-1 ring-brun/5">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Phase à la livraison</div>
            <div class="font-display text-2xl text-brun mt-1">Phase IV active</div>
          </div>
          <div class="bg-creme rounded-2xl p-5 ring-1 ring-brun/5">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Délai primordia post-entaille</div>
            <div class="font-display text-2xl text-brun mt-1">Jusqu'à 2 sem.</div>
          </div>
          <div class="bg-creme rounded-2xl p-5 ring-1 ring-brun/5">
            <div class="text-xs uppercase tracking-wider text-brun-clair/70">Volées par ballot</div>
            <div class="font-display text-2xl text-brun mt-1">2 (parfois 3)</div>
          </div>
        </div>

        <div class="mt-8 bg-creme rounded-2xl p-6 ring-1 ring-brun/5">
          <h3 class="text-base font-display text-brun">Aspect visuel — c'est normal qu'un bloc hericium ne soit pas blanc nacré</h3>
          <p class="mt-3 text-sm text-brun-clair leading-relaxed">
            Le bloc de hericium est différent des ballots eryngii ou pleurote&nbsp;: la <strong>colonisation est beaucoup plus éparse</strong>. On voit des points de colonisation et le réseau mycélien dessiné, sans le tapis blanc nacré uniforme. C'est la nature du mycélium hericium — pas une contamination, pas un défaut. À la première commande, c'est l'aspect qui surprend le plus les nouveaux clients.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 4 — Rendement et paramètres de fructification -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Rendement</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Rendement et <em class="italic text-violet-profond">paramètres de fructification</em></h2>

        <blockquote class="mt-6 border-l-4 border-lavande pl-5 py-3 italic text-brun font-display leading-relaxed">
          Quand on les atteint, on est vraiment très content et on fait la fête. Mais nous, on travaille sur du 20 %, et quand on a 25 % d'une façon plus ou moins régulière, on est content.
        </blockquote>

        <div class="mt-5 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Notre <strong>rendement par ballot d'hericium</strong> est calibré pour 20 % du poids du substrat, en cumul sur 2 à 3 volées. Quand un lot atteint 25 % de manière régulière, on est satisfaits. Les annonces concurrentes à 30 % existent — on préfère parler de qualité régulière. Pousser au-delà finit en carpophores gorgés d'eau, visqueux à la conservation, hors usage gastronomique.
          </p>
        </div>

        <div class="mt-8 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-brun/10 text-left">
                <th class="py-3 pr-4 font-semibold text-brun">Paramètre fructification hericium</th>
                <th class="py-3 font-semibold text-brun">Valeur</th>
              </tr>
            </thead>
            <tbody class="text-brun-clair">
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Température de culture</td>
                <td class="py-3 font-display text-brun">~ 18 °C</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Hygrométrie phase primordia</td>
                <td class="py-3 font-display text-brun">&gt; 95 %</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Hygrométrie phase fructification</td>
                <td class="py-3 font-display text-brun">&gt; 90 %</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Assèchements ponctuels (cadrage)</td>
                <td class="py-3 font-display text-brun">80–85 %</td>
              </tr>
              <tr class="border-b border-brun/5">
                <td class="py-3 pr-4">Air frais (FAE)</td>
                <td class="py-3 font-display text-brun">Élevé, continu</td>
              </tr>
              <tr>
                <td class="py-3 pr-4">Rendement constaté</td>
                <td class="py-3 font-display text-brun">20–25 %</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-sm text-brun-clair leading-relaxed">
          La fenêtre HR demande de la précision&nbsp;: si on humidifie trop en début de cycle, le champignon devient rose. C'est normal et réversible — quand on baisse l'humidité juste assez, il reprend sa couleur blanche. L'astuce, c'est de viser le seuil minimal pour les primordia, sans déborder.
        </p>
      </div>
    </section>

    <!-- H2 5 — Bûches vs ballots -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Bûche ou ballot</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Bûche ou ballot — <em class="italic text-violet-profond">lequel choisir</em>&nbsp;?</h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            <strong>La forme du substrat importe peu.</strong> Ce qui compte, c'est la formule, la souche, et les conditions de production.
          </p>
          <p>
            Certains producteurs proposent des blocs de 15 kg pour les très gros volumes industriels, ou des bûches reconstituées comme on en voit beaucoup en Asie. Nous avons fait le choix de blocs plus petits (2,5–2,7 kg)&nbsp;: <strong>manutention plus simple, cycles plus rythmés, pertes mieux maîtrisées</strong>. La culture sur sacs reste la solution la plus efficace en France et en Europe pour la production professionnelle.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 6 — Cas client : un chef étoilé qui prend 15 kg/semaine -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Cas client</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Un chef étoilé qui en prenait <em class="italic text-violet-profond">une quinzaine de kilos par semaine</em></h2>

        <blockquote class="mt-6 border-l-4 border-lavande pl-5 py-3 italic text-brun font-display leading-relaxed">
          On a eu un client étoilé qui en prenait une quinzaine de kilos par semaine. Le plus dur pour nous, c'était de calibrer les champignons. Et le temps qu'on apprenne à bien le faire, la saison de culture arrivait à sa fin. Alors on se dit : vivement la prochaine saison.
        </blockquote>

        <div class="mt-5 space-y-4 text-brun-clair leading-relaxed">
          <p>
            La cuisine étoilée demande un calibrage qu'on n'imagine pas&nbsp;: tous les carpophores d'un même service doivent avoir la même taille, la même densité de hydnes, le même état de fraîcheur. Sur le hericium — qui pousse en cascade asymétrique — c'est un vrai défi technique côté production.
          </p>
          <p>
            On l'a appris en faisant. Et on est encore en train d'apprendre. C'est exactement le genre de collaboration qu'on cherche pour les prochaines campagnes&nbsp;: cheffes &amp; chefs gastronomiques avec un volume régulier, qui acceptent d'ajuster ensemble la taille cible, et qui jouent le jeu de la saisonnalité.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 7 — Saisonnalité assumée -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Disponibilité</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Saisonnalité <em class="italic text-violet-profond">assumée</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Le hericium est un champignon de culture chaude — il s'épanouit aux alentours des 18 °C. Chez nous, la production se concentre sur les saisons où ce paramètre se tient sans coût énergétique disproportionné.
          </p>
          <p>
            On préfère <strong>n'en faire qu'en saison favorable</strong> plutôt que produire toute l'année avec des compromis sur la qualité. C'est aussi pourquoi cette page existe&nbsp;: vous y trouvez la fiche de référence, les paramètres de culture, notre méthode — et vous pouvez vous inscrire pour <strong>être prévenu·e dès la réouverture de campagne</strong>.
          </p>
          <p>
            Pour les myciculteurs qui souhaitent caler une commande sur la prochaine fenêtre, ou pour les restos qui veulent réserver un volume hebdomadaire, le devis pro reste ouvert toute l'année — on planifie avec vous.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 8 — Livraison -->
    <section class="bg-creme px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Livraison</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Livraison du substrat hericium — <em class="italic text-violet-profond">précautions et saisonnalité</em></h2>

        <div class="mt-6 space-y-4 text-brun-clair leading-relaxed">
          <p>
            Transport <strong>frigorifique obligatoire</strong> — le hericium est plus fragile au transport que le pleurote, et les périodes chaudes (qui sont aussi celles de production) imposent des précautions renforcées. Conditionnement adapté à la fragilité du ballot en phase IV active, transporteur partenaire frigo France métropolitaine ou votre transporteur si vous en avez un.
          </p>
          <p>
            Volumes recommandés pour une première campagne&nbsp;: <strong>unité ou demi-palette</strong> avant un volume palette régulier — la culture est exigeante, et on préfère que le premier essai se passe bien sur petit volume.
          </p>
          <p>
            Une fiche d'usage spécifique au hericium accompagne chaque commande&nbsp;: méthode d'entaille, consignes d'inclinaison, signaux d'alerte sur le calibrage.
          </p>
        </div>
      </div>
    </section>

    <!-- H2 9 — FAQ -->
    <section class="px-6 py-16">
      <div class="max-w-3xl mx-auto">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">FAQ</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Questions <em class="italic text-violet-profond">fréquentes</em></h2>

        <div class="mt-6">
          {FAQ_HERICIUM.map((item) => (
            <FAQItem question={item.question}>
              <Fragment set:html={item.answerHtml} />
            </FAQItem>
          ))}
        </div>
      </div>
    </section>

    <!-- Section intérêt prochaine campagne -->
    <section id="interet-hericium" class="bg-ivoire px-6 py-16">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Prochaine campagne</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Manifestez votre <em class="italic text-violet-profond">intérêt</em></h2>
        <p class="mt-4 text-brun-clair leading-relaxed max-w-xl mx-auto">
          Pas d'hericium en cours actuellement. Pour être prévenu·e de la réouverture de campagne, ou pour caler dès maintenant un volume sur la prochaine fenêtre&nbsp;: un mot via le formulaire pro, on revient vers vous avec le calendrier.
        </p>
