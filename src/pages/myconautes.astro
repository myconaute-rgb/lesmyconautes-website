---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import ArticleLd from "../components/seo/ArticleLd.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";
---

<BaseLayout
  title="À propos — Champignonnière artisanale FR-BIO-01 | Les Myconautes"
  description="Champignonnière artisanale fondée en 2015 à Rive-de-Gier (Loire). Producteur direct certifié FR-BIO-01, variétés exotiques bio (Hericium, Éryngii, Nameko). Florestan Grange et l'équipe."
  skin="refonte"
>
  <ArticleLd
    slug="myconautes"
    type="AboutPage"
    headline="À propos — Champignonnière artisanale FR-BIO-01"
    description="Champignonnière artisanale fondée en 2015 à Rive-de-Gier (Loire). Producteur direct certifié FR-BIO-01, variétés exotiques bio."
    about={["Les Myconautes", "Champignonnière artisanale", "Agriculture biologique", "Rive-de-Gier", "FR-BIO-01"]}
  />
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "À propos" },
  ]} />

  <PageHero
    variant="refonte"
    label="Notre histoire"
    title="Explorer le champignon depuis 2015"
    highlight="depuis 2015"
    description="Une champignonnière artisanale, certifiée bio, ancrée à Rive-de-Gier (Loire). Producteur direct, sans intermédiaire."
  />

  <div class="bg-page font-body text-brun">
    <!-- Histoire -->
    <section class="px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Une champignonnière, dix ans, et un terrain de 1,7 hectare</h2>
        <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">l'aventure</p>
        <div class="mt-8 text-brun leading-relaxed space-y-4">
          <p>
            Florestan a fondé sa première champignonnière en 2015. Dix ans plus tard, c'est devenu un refuge pour la biodiversité de 1,7 hectare niché à Rive-de-Gier, dans la Loire — entre Lyon et Saint-Étienne.
          </p>
          <p>
            Chaque champignon est cultivé, récolté à la main et conditionné ici même. Circuit court strict, traçabilité totale, et la conviction que le bio en France ne devrait pas se limiter au champignon de Paris.
          </p>
          <p>
            Au catalogue : pleurote, éryngii, hericium, Black Pearl. Et pour les pros qui veulent se lancer dans la culture, des substrats inoculés certifiés FR-BIO-01.
          </p>
        </div>
      </div>
    </section>

    <!-- Argument bio total — bande violette signature à gauche -->
    <section class="relative py-20 md:py-28 overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-8 lg:w-24 bg-violet hidden md:block" aria-hidden="true"></div>
      <div class="max-w-3xl mx-auto px-6 md:px-10 lg:pl-24">
        <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Bio total, sans compromis</h2>
        <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">bio FR-BIO-01</p>
        <p class="mt-8 text-brun leading-relaxed">
          Notre certification FR-BIO-01 couvre tout le cycle : culture, conditionnement, traçabilité — c'est Ecocert qui contrôle. Concrètement, nos champignons poussent sans traitement, et dans les salles, on mise sur l'hygiène et le soin plutôt que sur la chimie.
        </p>

        <div class="mt-8 inline-flex items-center gap-4 bg-lilas px-6 py-4">
          <span class="text-3xl" aria-hidden="true">🌱</span>
          <div class="text-sm">
            <div class="font-semibold text-cacao">Certification FR-BIO-01.250-0043443.2026.003</div>
            <div class="text-brun">Organisme certificateur : Ecocert</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Valeurs -->
    <section class="px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Ce qui guide nos choix</h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">nos valeurs</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-lilas p-6">
            <div class="text-3xl mb-3" aria-hidden="true">🛡️</div>
            <h3 class="font-title text-lg text-cacao">Bio sans compromis</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Certifié FR-BIO-01 jusqu'aux ingrédients du substrat.</p>
          </div>
          <div class="bg-lilas p-6">
            <div class="text-3xl mb-3" aria-hidden="true">✋</div>
            <h3 class="font-title text-lg text-cacao">Récolte à la main</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Pas de robotisation. Des yeux humains, du soin.</p>
          </div>
          <div class="bg-lilas p-6">
            <div class="text-3xl mb-3" aria-hidden="true">📍</div>
            <h3 class="font-title text-lg text-cacao">Circuit court</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Cultivés, récoltés, conditionnés ici. Zéro intermédiaire.</p>
          </div>
          <div class="bg-lilas p-6">
            <div class="text-3xl mb-3" aria-hidden="true">♻️</div>
            <h3 class="font-title text-lg text-cacao">Pratiques durables</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Gestion raisonnée de l'eau, des emballages, des cycles.</p>
          </div>
        </div>
      </div>
    </section>

    <CTASection
      variant="editorial"
      title="Une visite, ça vous tente ?"
      description="On peut vous faire visiter la champignonnière sur rendez-vous. Lun – Ven, 7h à 13h."
      primaryCta={{ href: "/contact", label: "Prendre rendez-vous" }}
      secondaryCta={{ href: "/agriculteurs", label: "Découvrir les substrats" }}
    />
  </div>
</BaseLayout>
