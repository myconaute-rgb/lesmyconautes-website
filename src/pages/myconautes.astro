---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import FaqCommune from "../components/FaqCommune.astro";
import ContactSection from "../components/ContactSection.astro";
import GammeSection from "../components/GammeSection.astro";
import CTASection from "../components/CTASection.astro";
import ArticleLd from "../components/seo/ArticleLd.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";

import heroBandPic from "../assets/photos/bandeau-eryngii.jpg";
/* Placeholder du cadre « l'aventure » : le portrait de Florestan tient la
   place en attendant l'image annoncée dans le patch DA du 25/07. */
import aventurePic from "../assets/photos/florestan-portrait.jpg";
import certifieAbLogo from "../assets/logos/certifie-ab.png";
import certifieEuLogo from "../assets/logos/certifie-eu.png";
import envieGouterPic from "../assets/photos/envie-gouter.jpg";

const orderHref = "https://www.pourdebon.com/les-myconautes-s1527";

const VALEURS = [
  { icon: "bio", title: "100% bio certifié", text: "Certifié FR-BIO-01 jusqu'aux ingrédients du substrat." },
  { icon: "francais", title: "Français", text: "Cultivés et récoltés en France, dans la Loire." },
  { icon: "main", title: "Récolte à la main", text: "Pas de robotisation. Des yeux humains, du soin." },
  { icon: "durable", title: "Agriculture durable", text: "Gestion raisonnée de l'eau, des emballages, des cycles." },
  { icon: "circuit", title: "Circuit court", text: "Cultivés, récoltés, conditionnés ici. Zéro intermédiaire." },
] as const;
---

<BaseLayout
  title="À propos — Champignonnière artisanale FR-BIO-01 | Les Myconautes"
  description="Champignonnière artisanale fondée en 2015 à Rive-de-Gier (Loire). Producteur direct certifié FR-BIO-01, variétés exotiques bio (Hericium, Éryngii, Nameko). Florestan Grange et l'équipe."
  skin="refonte"
>
  <ArticleLd
    slug="myconautes"
    type="AboutPage"
    headline="À propos — Champignonnière artisanale FR-BIO-01"
    description="Champignonnière artisanale fondée en 2015 à Rive-de-Gier (Loire). Producteur direct certifié FR-BIO-01, variétés exotiques bio."
    about={["Les Myconautes", "Champignonnière artisanale", "Agriculture biologique", "Rive-de-Gier", "FR-BIO-01"]}
  />
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "À propos" },
  ]} />

  <div class="bg-page font-body text-brun">
    <!-- Hero violet + bande lilas -->
    <section class="bg-page">
      <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 md:pt-14 pb-8">
        <h1 class="font-title text-[clamp(2.4rem,6.5vw,5.5rem)] leading-[0.98] text-violet">
          Explorateurs du champignon <em class="italic">depuis 2015</em>
        </h1>
      </div>
      <div class="relative h-64 md:h-96 bg-lilas overflow-hidden">
        <Image src={heroBandPic} alt="Cagette d'eryngii fraîchement récoltés — Les Myconautes" loading="eager" decoding="async" widths={[640,960,1280,1600]} sizes="100vw" formats={["avif","webp"]} class="w-full h-full object-cover object-top" />
      </div>
    </section>

    <!-- Histoire -->
    <section class="relative py-14 md:py-20 overflow-hidden">
      <div class="absolute inset-y-0 right-0 w-8 lg:w-24 bg-violet hidden md:block" aria-hidden="true"></div>
      <div class="max-w-6xl mx-auto px-6 md:px-10">
        <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Une champignonnière, dix ans d'expérience, et un terrain de 1,7 hectare</h2>
        <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">l'aventure</p>

        <!-- Patch DA 25/07 : 2 cadres côte à côte — visuel à gauche, récit à droite. -->
        <div class="mt-8 grid md:grid-cols-2 gap-10 items-stretch">
          <div class="relative min-h-[320px] md:min-h-[420px] overflow-hidden">
            <Image
              src={aventurePic}
              alt="Florestan, fondateur des Myconautes, avec une brassée de champignons"
              loading="lazy"
              decoding="async"
              widths={[400, 600, 800, 1200, 1600]}
              sizes="(min-width: 768px) 50vw, 100vw"
              formats={["avif", "webp"]}
              class="absolute inset-0 w-full h-full object-cover object-top"
            />
          </div>
          <div class="text-left text-brun leading-relaxed space-y-4 self-center">
            <p>Florestan a fondé sa première champignonnière en 2015. Dix ans plus tard, c'est devenu un refuge pour la biodiversité de 1,7 hectare niché à Rive-de-Gier, dans la Loire — entre Lyon et Saint-Étienne.</p>
            <p>Chaque champignon est cultivé, récolté à la main et conditionné ici même. Circuit court strict, traçabilité totale, et la conviction que le bio en France ne devrait pas se limiter au champignon de Paris.</p>
            <p>Au catalogue : pleurote, éryngii, hericium, Black Pearl. Et pour les pros qui veulent se lancer dans la culture, des substrats inoculés certifiés FR-BIO-01.</p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={orderHref} target="_blank" rel="noopener" class="inline-flex items-center px-8 py-4 rounded-btn bg-violet text-page text-sm font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors">Commander</a>
          <a href="/#univers" class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-violet text-violet text-sm font-semibold tracking-wide uppercase hover:bg-violet/10 transition-colors">Découvrir nos univers</a>
        </div>
      </div>
    </section>

    <!-- Bio total + valeurs -->
    <section class="px-6 md:px-10 py-14 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-10 items-stretch mb-16">
          <div>
            <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Bio total, sans compromis</h2>
            <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">nos valeurs, nos choix</p>
            <p class="mt-8 text-brun leading-relaxed">
              Notre certification FR-BIO-01 couvre tout le cycle : culture, conditionnement, traçabilité — c'est Ecocert qui contrôle. Concrètement, nos champignons poussent sans traitement, et dans les salles, on mise sur l'hygiène et le soin plutôt que sur la chimie.
            </p>
            <p class="mt-4 text-sm text-brun/80">Certification FR-BIO-01.250-0043443.2026.003<br />Organisme certificateur : Ecocert</p>
          </div>
          <div class="flex items-center justify-center gap-8 md:gap-10 bg-creme/40 px-6 py-10">
            <Image src={certifieAbLogo} alt="Certifié Agriculture Biologique" loading="lazy" widths={[240,400]} sizes="(min-width: 768px) 200px, 40vw" formats={["avif","webp"]} class="h-40 md:h-56 w-auto" />
            <Image src={certifieEuLogo} alt="Certifié FR-BIO-01 — Agriculture France / UE" loading="lazy" widths={[320,560]} sizes="(min-width: 768px) 280px, 50vw" formats={["avif","webp"]} class="h-40 md:h-56 w-auto" />
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10">
          {VALEURS.map((v) => (
            <div class="text-center">
              <FeatureIcon name={v.icon} />
              <h3 class="mt-4 font-title text-lg text-cacao">{v.title}</h3>
              <p class="mt-1 text-sm text-brun leading-relaxed">{v.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <GammeSection titleTone="violet" scriptTone="anis" />

    <FaqCommune titleTone="violet" scriptTone="anis" />

    <ContactSection
      formType="contact"
      messageRequired={true}
      scriptTone="anis"
      intro="Que ce soit pour partager une recette, obtenir nos tarifs & conditions de vente, demander des détails techniques sur nos substrats ou nous avouer que vous adorez nos champignons … on vous réponds !"
    />

    <CTASection
      variant="editorial"
      title="Envie de goûter ?"
      description="Passez-nous commande directement via Pour de Bon, ou contactez-nous pour les volumes pro."
      image={envieGouterPic}
      imageAlt="Dégustation de champignons poêlés"
      primaryCta={{ href: orderHref, label: "Commander en ligne" }}
      secondaryCta={{ href: "/contact", label: "Nous écrire" }}
    />
  </div>
</BaseLayout>
