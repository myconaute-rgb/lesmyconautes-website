---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import HoneypotField from "../components/HoneypotField.astro";
import { AGRI_SPECIES, SUBSTRATE_FORMATS } from "../data/agri_species";
---

<BaseLayout
  title="Substrat champignon bio FR-BIO-01 — Producteur Rhône-Alpes | Les Myconautes"
  description="Fournisseur direct de substrat champignon bio en France. Éryngii, hericium, pleurote — bientôt nameko, shiitaké et pleurote jaune. Certifié FR-BIO-01 par Ecocert. Sac 2,5 kg, demi-palette 200 kg, palette 500 kg. Devis sur demande."
>
  <PageHero
    theme="turquoise"
    label="Pour la production"
    title="Substrats et mycélium bio pour champignonnistes"
    highlight="champignonnistes"
    description="Après six ans de culture, on a fabriqué notre propre substrat — et on le rend accessible. Toute la production est certifiée Agriculture Biologique."
    primaryCta={{ href: "#contact-agri", label: "Demander un devis" }}
    secondaryCta={{ href: "#especes", label: "Voir le catalogue" }}
  />

  <!-- Argument FR-BIO-01 (différenciant SEO principal) -->
  <section class="bg-creme px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-[2fr_1fr] gap-10 items-center">
        <div>
          <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Pourquoi nous</span>
          <h2 class="mt-2 text-3xl md:text-4xl text-brun">Le seul fournisseur de substrat champignon <em class="italic text-turquoise">FR-BIO-01</em> en Rhône-Alpes</h2>
          <div class="mt-6 text-brun-clair leading-relaxed space-y-3">
            <p>
              <strong class="text-brun">Bio français, certifié FR-BIO-01.</strong> Cultivé et conditionné en Rhône-Alpes, sous le numéro Ecocert FR-BIO-01.250-0043443.2026.003. Vous savez exactement d'où vient votre substrat.
            </p>
            <p>
              <strong class="text-brun">Producteur direct.</strong> On fabrique nous-mêmes le substrat dans notre atelier — vous ne passez pas par un distributeur.
            </p>
            <p>
              <strong class="text-brun">Variétés exotiques bio</strong> que les gros fabricants ne proposent pas en bio : Hericium, Nameko, Pleurote jaune.
            </p>
            <p>
              <strong class="text-brun">Bio sans compromis.</strong> Aucun produit sur les champignons. Pas de produits dans la nourriture (paille, son de blé, céréales). Pas d'insecticides en salles. Tous les achats justifiés par certificat bio fournisseur.
            </p>
          </div>
        </div>

        <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5 text-center">
          <div class="text-5xl mb-3" aria-hidden="true">🌱</div>
          <div class="font-display text-lg text-brun leading-tight">Certifié<br/>FR-BIO-01</div>
          <div class="mt-2 text-xs text-brun-clair break-words">FR-BIO-01.250-0043443<br/>.2026.003</div>
          <div class="mt-3 inline-block px-3 py-1 rounded-full bg-turquoise/15 text-turquoise text-xs font-semibold">Ecocert</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Espèces -->
  <section id="especes" class="px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Nos substrats</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Substrats <em class="italic text-turquoise">prêts à l'emploi</em></h2>
        <p class="mt-3 text-brun-clair max-w-xl mx-auto">
          Fabriqués dans notre atelier à Rive-de-Gier. Mycélium ensemencé, stérilisé à l'autoclave, prêts à fructifier.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {AGRI_SPECIES.map((sp) => (
          <article class={`relative bg-ivoire rounded-2xl ring-1 ring-brun/5 overflow-hidden ${sp.tag ? "opacity-95" : ""}`}>
            <div class={`aspect-[5/3] relative overflow-hidden ${sp.imagePath ? "bg-creme" : "bg-gradient-to-br from-creme via-brun-clair/20 to-turquoise/20"}`}>
              {sp.imagePath ? (
                <img
                  src={sp.imagePath}
                  alt={sp.imageAlt ?? `${sp.name} (${sp.latin})`}
                  loading="lazy"
                  decoding="async"
                  class={`w-full h-full object-cover ${sp.tag ? "saturate-50" : ""}`}
                />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center text-5xl" aria-hidden="true">🍄</span>
              )}
              {sp.tag && (
                <span class="absolute top-3 right-3 px-3 py-1 rounded-full bg-lavande/95 text-ivoire text-xs font-semibold uppercase tracking-wider shadow-sm backdrop-blur-sm">
                  🟣 {sp.tag}
                </span>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-lg text-brun">{sp.name}</h3>
              <p class="font-display italic text-xs text-brun-clair/70 mt-0.5">{sp.latin}</p>
              <p class="mt-3 text-sm text-brun-clair leading-relaxed">{sp.blurb}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {sp.stats.map((stat) => (
                  <span class="text-xs px-2.5 py-1 rounded-full bg-creme text-brun-clair border border-brun/5">
                    {stat}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-creme px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Notre process</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Du substrat à la récolte</h2>
        <p class="mt-3 text-brun-clair max-w-xl mx-auto">
          On vous livre un substrat prêt à l'emploi, pour vous concentrer sur la partie la plus gratifiante : la fructification.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5 relative">
          <span class="font-display text-5xl text-turquoise/30 absolute top-2 right-4 leading-none">01</span>
          <h4 class="text-base text-brun relative">Fabrication</h4>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed relative">
            Sciure, son de blé, eau — substrat fabriqué dans notre atelier, stérilisé à l'autoclave (107-109°C).
          </p>
        </div>
        <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5 relative">
          <span class="font-display text-5xl text-lavande/30 absolute top-2 right-4 leading-none">02</span>
          <h4 class="text-base text-brun relative">Ensemencement</h4>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed relative">
            Inoculation avec du mycélium de qualité. Mise en sac stérile dans notre laboratoire.
          </p>
        </div>
        <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5 relative">
          <span class="font-display text-5xl text-terracotta/30 absolute top-2 right-4 leading-none">03</span>
          <h4 class="text-base text-brun relative">Incubation</h4>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed relative">
            Le mycélium colonise le substrat. On vous le livre prêt à fructifier.
          </p>
        </div>
        <div class="bg-ivoire rounded-2xl p-6 ring-1 ring-brun/5 relative">
          <span class="font-display text-5xl text-turquoise/30 absolute top-2 right-4 leading-none">04</span>
          <h4 class="text-base text-brun relative">Fructification</h4>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed relative">
            Chez vous : ouvrez le sac, maintenez l'humidité et l'air frais. Quelques jours plus tard, ça pousse.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conditionnements -->
  <section class="px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <!-- Bandeau visuel substrat pro -->
      <div class="aspect-[5/3] sm:aspect-[16/6] rounded-3xl overflow-hidden mb-12 ring-1 ring-brun/10 shadow-sm">
        <img
          src="/photos/substrat-pro-paysage.jpg"
          alt="Substrat pro Les Myconautes — sac inoculé prêt à fructifier"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Conditionnements</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Du sac unitaire à la palette</h2>
        <p class="mt-3 text-brun-clair max-w-xl mx-auto">
          Tarifs dégressifs selon le volume. Devis sur demande, conditions pro.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
        {SUBSTRATE_FORMATS.map((fmt, i) => {
          // La card "Palette complète" (i=2) reçoit la photo carré substrat-pro.
          const isPallet = i === 2;
          return (
            <div class={`rounded-2xl ring-1 ring-brun/5 hover:-translate-y-1 transition overflow-hidden ${isPallet ? "bg-ivoire" : "bg-creme p-6 text-center"}`}>
              {isPallet && (
                <div class="aspect-square overflow-hidden">
                  <img
                    src="/photos/substrat-pro.jpg"
                    alt="Palette de substrat pro Les Myconautes"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}
              <div class={`${isPallet ? "p-6 text-center" : ""}`}>
                {!isPallet && <div class="text-3xl mb-3" aria-hidden="true">{["📦", "🚜"][i]}</div>}
                <h3 class="text-lg text-brun">{fmt.label}</h3>
                <div class="mt-1 font-display italic text-sm text-turquoise">{fmt.weight}</div>
                <p class="mt-3 text-sm text-brun-clair leading-relaxed">{fmt.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Devis -->
  <section id="contact-agri" class="bg-creme px-6 py-20">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Devis substrat</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Demandez un devis adapté</h2>
        <p class="mt-3 text-brun-clair max-w-xl mx-auto">
          Indiquez les espèces et volumes souhaités. Réponse rapide avec proposition adaptée.
        </p>
      </div>

      <form class="grid gap-4 bg-ivoire rounded-2xl p-8 ring-1 ring-brun/5" data-agri-form>
        <HoneypotField />
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="af-name" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Nom / structure</label>
            <input id="af-name" name="name" type="text" required class="w-full px-4 py-3 rounded-xl bg-creme border-2 border-brun/10 focus:border-turquoise focus:outline-none text-sm" />
          </div>
          <div>
            <label for="af-email" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Email</label>
            <input id="af-email" name="email" type="email" required class="w-full px-4 py-3 rounded-xl bg-creme border-2 border-brun/10 focus:border-turquoise focus:outline-none text-sm" />
          </div>
        </div>
        <div>
          <label for="af-phone" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Téléphone</label>
          <input id="af-phone" name="phone" type="tel" class="w-full px-4 py-3 rounded-xl bg-creme border-2 border-brun/10 focus:border-turquoise focus:outline-none text-sm" />
        </div>
        <div>
          <label for="af-species" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Espèces souhaitées</label>
          <input id="af-species" name="species" type="text" required placeholder="Pleurote, éryngii, hericium…" class="w-full px-4 py-3 rounded-xl bg-creme border-2 border-brun/10 focus:border-turquoise focus:outline-none text-sm" />
        </div>
        <div>
          <label for="af-volume" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Volume estimé</label>
          <input id="af-volume" name="volume" type="text" placeholder="Sacs / demi-palette / palette · fréquence" class="w-full px-4 py-3 rounded-xl bg-creme border-2 border-brun/10 focus:border-turquoise focus:outline-none text-sm" />
        </div>
        <div>
          <label for="af-msg" class="block text-xs font-semibold uppercase tracking-wider text-brun-clair mb-1">Détails</label>
          <textarea id="af-msg" name="message" rows="4" placeholder="Type de production, calendrier, contraintes…" class="w-full px-4 py-3 rounded-xl bg-creme border-2 border-brun/10 focus:border-turquoise focus:outline-none text-sm resize-y"></textarea>
        </div>
        <button type="submit" class="justify-self-start inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brun text-ivoire font-semibold hover:brightness-110 transition shadow-sm">
          Envoyer ma demande →
        </button>
        <p class="text-xs text-brun-clair/70 leading-relaxed">
          En envoyant ce formulaire, vous acceptez que vos données (nom, email, tél., espèces et volumes) soient utilisées pour établir un devis. <a href="/mentions-legales" class="underline hover:text-violet-profond">Plus d'infos</a>.
        </p>
        <p class="hidden text-sm text-turquoise font-semibold" data-form-success>
          Merci, votre demande est partie. On revient vers vous très vite.
        </p>
        <p class="hidden text-sm text-terracotta font-semibold" data-form-error>
          Une erreur est survenue. Réessayez, ou écrivez directement à <span class="underline">myconaute &#x40; pm.me</span>.
        </p>
      </form>
    </div>
  </section>

  <CTASection
    title="Une question avant de se lancer ?"
    description="On peut échanger par téléphone, par mail ou de visu sur place."
    primaryCta={{ href: "#contact-agri", label: "Demander un devis" }}
    secondaryCta={{ href: "/", label: "Retour accueil" }}
  />
</BaseLayout>

<script>
  import { wireContactForm } from "../scripts/contact-form";
  const form = document.querySelector<HTMLFormElement>("[data-agri-form]");
  if (form) wireContactForm(form, "devis_substrat");
</script>
