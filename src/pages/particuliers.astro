---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import GammeCard from "../components/GammeCard.astro";
import FAQItem from "../components/FAQItem.astro";
import CTASection from "../components/CTASection.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";
import { VARIETIES } from "../data/varieties";

/* Cartes variétés en style DA (aplat couleur, sans lien : les pages
   /varietes/<slug> n'existent pas — même décision que sur l'accueil). */
const CARD_TONES = ["mauve", "jaune", "bleu", "sable"] as const;
---

<BaseLayout
  title="Kit culture champignon bio &amp; champignons frais à domicile | Les Myconautes"
  description="Cultivez vos champignons à la maison avec nos substrats prêts à l'emploi (pleurote, éryngii, hericium) certifiés FR-BIO-01. Champignons frais bio livrés Lyon, Saint-Étienne, et France entière via Pour de Bon."
  skin="refonte"
>
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "Particuliers" },
  ]} />
  <PageHero
    variant="refonte"
    label="Cuisine, plaisir & curiosité"
    title="Bienvenue dans le monde extraordinaire des champignons"
    highlight="champignons"
    description="Frais, séchés, épicerie fine et substrats en petits volumes — la même qualité que pour les pros, mais à votre échelle."
    primaryCta={{ href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander sur Pour de Bon" }}
    secondaryCta={{ href: "#culture", label: "Cultiver chez moi" }}
  />

  <div class="bg-page font-body text-brun">
    <!-- 3 catégories d'offre -->
    <section class="px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Tout un monde à explorer</h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">notre offre</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class="group flex flex-col bg-lilas p-8 hover:bg-lilas/80 transition-colors">
            <div class="text-4xl mb-4" aria-hidden="true">🍄</div>
            <h3 class="font-title text-xl text-cacao">Champignons frais</h3>
            <p class="mt-3 text-sm text-brun leading-relaxed grow">
              Hericium, éryngii, pleurotes — récoltés chaque jour, livrés chez vous.
            </p>
            <span class="mt-6 inline-block text-xs font-semibold uppercase tracking-widest text-cacao">Commander</span>
          </a>
          <a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class="group flex flex-col bg-jaune p-8 hover:brightness-95 transition">
            <div class="text-4xl mb-4" aria-hidden="true">🫙</div>
            <h3 class="font-title text-xl text-cacao">Épicerie fine</h3>
            <p class="mt-3 text-sm text-brun leading-relaxed grow">
              Veloutés, champignons séchés, pickles et produits transformés artisanaux.
            </p>
            <span class="mt-6 inline-block text-xs font-semibold uppercase tracking-widest text-cacao">Commander</span>
          </a>
          <a href="#culture" class="group flex flex-col bg-anis text-page p-8 hover:bg-anis/90 transition-colors">
            <div class="text-4xl mb-4" aria-hidden="true">🌱</div>
            <h3 class="font-title text-xl">Faites pousser !</h3>
            <p class="mt-3 text-sm leading-relaxed grow text-page/90">
              Substrats en petits volumes pour cultiver vos champignons à la maison.
            </p>
            <span class="mt-6 inline-block text-xs font-semibold uppercase tracking-widest">Comment faire</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Variétés — bande violette signature à gauche -->
    <section class="relative py-20 md:py-28 overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-8 lg:w-20 bg-violet hidden md:block" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-10 lg:pl-32">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">
            Une qualité <em class="italic">incomparable</em>
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">nos champignons</p>
          <p class="mt-6 max-w-2xl text-brun leading-relaxed">
            Propres, parés, aucun lavage nécessaire. Envoi frigorifique pour un résultat magnifique.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {VARIETIES.map((v, i) => (
            <GammeCard
              title={v.name}
              sub={v.latin}
              text={v.blurb}
              image={v.image!}
              imageAlt={v.imageAlt ?? `${v.name} (${v.latin})`}
              tone={CARD_TONES[i % CARD_TONES.length]}
              badge={v.tag ? `${v.tag} !` : undefined}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Livraison & retrait -->
    <section class="px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">
            Comment <em class="italic">recevoir</em> vos champignons
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">livraison &amp; retrait</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-lilas p-8 flex flex-col">
            <h3 class="font-title text-xl text-cacao">Retrait sur place</h3>
            <p class="mt-5 text-sm text-brun leading-relaxed">
              5 rue Vallée de Couzon<br/>42800 Rive-de-Gier<br/>Lun – Ven, 7h à 13h
            </p>
            <div class="mt-auto pt-8 font-title text-lg text-cacao">Gratuit</div>
          </div>
          <div class="bg-lilas p-8 flex flex-col">
            <h3 class="font-title text-xl text-cacao">Livraison Lyon</h3>
            <p class="mt-5 text-sm text-brun leading-relaxed">
              Vendredi 8h – 12h<br/>Rayon 5 km<br/>Min. 25 €
            </p>
            <div class="mt-auto pt-8 font-title text-lg text-cacao">2,00 €</div>
          </div>
          <div class="bg-lilas p-8 flex flex-col">
            <h3 class="font-title text-xl text-cacao">Livraison Saint-Étienne</h3>
            <p class="mt-5 text-sm text-brun leading-relaxed">
              Jeudi 8h – 12h<br/>Rayon 5 km<br/>Min. 25 €
            </p>
            <div class="mt-auto pt-8 font-title text-lg text-cacao">2,00 €</div>
          </div>
          <div class="bg-lilas p-8 flex flex-col">
            <h3 class="font-title text-xl text-cacao">Partout en France</h3>
            <p class="mt-5 text-sm text-brun leading-relaxed">
              Via <a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class="font-semibold underline underline-offset-4 hover:text-violet transition-colors">Pour de Bon</a>
            </p>
            <div class="mt-auto pt-8 font-title text-lg text-cacao">Voir tarifs</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cultiver chez soi -->
    <section id="culture" class="px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Lancez-vous dans la culture maison</h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">cultiver chez vous</p>
          <p class="mt-6 max-w-2xl text-brun leading-relaxed">
            La même offre que pour les pros, en petits volumes. Substrat prêt à l'emploi et conseils inclus.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-sable p-6">
            <h4 class="font-title text-lg text-cacao">🌱 Substrat prêt à l'emploi</h4>
            <p class="mt-3 text-sm text-brun leading-relaxed">
              Fabriqué et ensemencé chez nous. Vous, vous gardez la partie la plus gratifiante : voir pousser vos champignons.
            </p>
          </div>
          <div class="bg-sable p-6">
            <h4 class="font-title text-lg text-cacao">💧 Maintenez l'humidité</h4>
            <p class="mt-3 text-sm text-brun leading-relaxed">
              Munissez-vous d'un brumisateur. L'humidité est primordiale — sans elle, rien ne se passe.
            </p>
          </div>
          <div class="bg-sable p-6">
            <h4 class="font-title text-lg text-cacao">🌬️ Air frais</h4>
            <p class="mt-3 text-sm text-brun leading-relaxed">
              Exposez le substrat à l'air frais. Évitez les espaces confinés et la proximité d'un chauffage.
            </p>
          </div>
          <div class="bg-sable p-6">
            <h4 class="font-title text-lg text-cacao">⏱️ Patience</h4>
            <p class="mt-3 text-sm text-brun leading-relaxed">
              Laissez le sac fermé jusqu'à l'apparition des primordias (petits pompons blancs), puis ouvrez. Quelques jours plus tard, c'est prêt.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ — bande violette signature à gauche -->
    <section class="relative py-20 md:py-28 overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-8 lg:w-40 bg-violet hidden md:block" aria-hidden="true"></div>
      <div class="max-w-4xl mx-auto px-6 md:px-10">
        <div class="mb-10">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">Tout savoir avant de commander</h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">questions fréquentes</p>
        </div>

        <div class="bg-creme/60 px-6 md:px-10 py-8">
          <FAQItem variant="editorial" question="Vos champignons sont-ils bio ?">
            Oui. Label FR-BIO-01, cultivés sans pesticide, pratiques durables et raisonnées.
          </FAQItem>
          <FAQItem variant="editorial" question="Faut-il les laver ?">
            Non, ils sont propres et parés. Un simple essuyage suffit si besoin.
          </FAQItem>
          <FAQItem variant="editorial" question="Combien de temps se conservent-ils ?">
            8 à 10 jours au réfrigérateur (0 à 4°C) dans leur emballage d'origine.
          </FAQItem>
          <FAQItem variant="editorial" question="Puis-je les congeler ?">
            Préférez les poêler légèrement avant congélation pour préserver texture et goût.
          </FAQItem>
          <FAQItem variant="editorial" question="Y a-t-il un minimum de commande ?">
            Aucun minimum sur Pour de Bon. Pour la livraison à domicile (Lyon / Saint-Étienne), minimum 25 €.
          </FAQItem>
          <FAQItem variant="editorial" question="Comment fonctionne le retrait ?">
            Récupérez gratuitement le lendemain de votre commande au 5 rue Vallée de Couzon, Rive-de-Gier. Lun – Ven, 7h à 13h. Conservation au frais 3 jours.
          </FAQItem>
        </div>
      </div>
    </section>

    <CTASection
      variant="editorial"
      title="Envie de goûter ?"
      description="Commandez en ligne, ou venez nous rendre visite à Rive-de-Gier."
      primaryCta={{ href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander en ligne" }}
      secondaryCta={{ href: "/contact", label: "Nous écrire" }}
    />
  </div>
</BaseLayout>
