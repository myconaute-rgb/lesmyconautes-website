---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import StepCard from "../components/StepCard.astro";
import FaqCommune from "../components/FaqCommune.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import CTASection from "../components/CTASection.astro";
import DeliveryGrid from "../components/DeliveryGrid.astro";
import BreadcrumbLd from "../components/seo/BreadcrumbLd.astro";

import heroBandPic from "../assets/photos/bandeau-eryngii.jpg";
import fraisPic from "../assets/photos/hero-cagette-eryngii.jpg";
import epiceriePic from "../assets/photos/epicerie-pickles.jpg";
import substratPic from "../assets/photos/substrat-bloc.jpg";
import cultureBandPic from "../assets/photos/substrat-bloc.jpg";
import envieGouterPic from "../assets/photos/envie-gouter.jpg";
import etapeCommandeIcon from "../assets/icons/aline/clic.png";
import etapeRecolteIcon from "../assets/icons/aline/pick.png";
import etapeCartonIcon from "../assets/icons/aline/colis.png";

const orderHref = "https://www.pourdebon.com/les-myconautes-s1527";
---

<BaseLayout
  title="Kit culture champignon bio &amp; champignons frais à domicile | Les Myconautes"
  description="Cultivez vos champignons à la maison avec nos substrats prêts à l'emploi (pleurote, éryngii, hericium) certifiés FR-BIO-01. Champignons frais bio livrés Lyon, Saint-Étienne, et France entière via Pour de Bon."
  skin="refonte"
>
  <BreadcrumbLd items={[
    { name: "Accueil", url: "/" },
    { name: "Particuliers" },
  ]} />

  <div class="bg-page font-body text-brun">
    <!-- Hero : titre violet + bande violette + 2 boutons -->
    <section class="bg-page">
      <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 md:pt-14 pb-8">
        <h1 class="font-title text-[clamp(2.4rem,6.5vw,5.5rem)] leading-[0.98] text-violet">
          Bienvenue dans le monde <em class="italic">extraordinaire</em> des champignons
        </h1>
      </div>
      <div class="relative h-64 md:h-96 bg-violet overflow-hidden">
        <Image
          src={heroBandPic}
          alt="Cagette d'eryngii fraîchement récoltés — Les Myconautes"
          loading="eager"
          decoding="async"
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          formats={["avif", "webp"]}
          class="w-full h-full object-cover"
        />
      </div>
      <div class="max-w-3xl mx-auto px-6 md:px-10 pt-10 text-brun leading-relaxed space-y-4">
        <p>
          Bienvenue chez Les Myconautes ! À Rive-de-Gier, nous cultivons des champignons bio d'exception, récoltés à la main chaque jour et produits dans le respect de la nature. Notre mission est simple : vous faire découvrir des champignons frais, savoureux et locaux, cultivés en circuit court selon des pratiques agricoles durables. Certifiés Bio FR-BIO-01, ils sont le reflet d'un savoir-faire artisanal et d'une véritable passion pour le vivant.
        </p>
        <p>
          Cuisine saine, facile et bons petits plats qui changent ? Rejoignez l'équipage des explorateurs du champignon !
        </p>
      </div>
      <div class="max-w-7xl mx-auto px-6 md:px-10 py-10 flex flex-wrap justify-center gap-4">
        <a href={orderHref} target="_blank" rel="noopener" class="inline-flex items-center px-8 py-4 rounded-btn bg-violet text-page text-sm font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors">
          Commander sur Pour de Bon
        </a>
        <a href="#culture" class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-violet text-violet text-sm font-semibold tracking-wide uppercase hover:bg-violet/10 transition-colors">
          Cultiver chez vous
        </a>
      </div>
    </section>

    <!-- Offre : 3 colonnes photo + bouton -->
    <section class="px-6 md:px-10 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">
            Tout un monde <em class="italic">à explorer</em>
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">cuisine, plaisir &amp; curiosité</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
          <div class="flex flex-col">
              <h3 class="font-title text-xl text-cacao">Champignons frais</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Pleurotes, eryngii, hericium … récoltés chaque jour, livrés chez vous.</p>
            <div class="mt-6 aspect-[4/3] overflow-hidden">
              <Image src={fraisPic} alt="Champignons frais en cagette" loading="lazy" decoding="async" widths={[320,480,640]} sizes="(min-width:768px) 400px, 100vw" formats={["avif","webp"]} class="w-full h-full object-cover" />
            </div>
            <a href={orderHref} target="_blank" rel="noopener" class="mt-6 self-center inline-flex items-center px-7 py-3.5 rounded-btn bg-violet text-page text-xs font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors">Commander</a>
          </div>

          <div class="flex flex-col">
              <h3 class="font-title text-xl text-cacao">Epicerie fine</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Pickles, velouté, mouliné : découvrez le champignon autrement !</p>
            <div class="mt-6 aspect-[4/3] overflow-hidden">
              <Image src={epiceriePic} alt="Pickles d'Eryngii — épicerie fine" loading="lazy" decoding="async" widths={[320,480,640]} sizes="(min-width:768px) 400px, 100vw" formats={["avif","webp"]} class="w-full h-full object-cover" />
            </div>
            <a href={orderHref} target="_blank" rel="noopener" class="mt-6 self-center inline-flex items-center px-7 py-3.5 rounded-btn bg-violet text-page text-xs font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors">Commander</a>
          </div>

          <div class="flex flex-col">
              <h3 class="font-title text-xl text-cacao">Ca pousse !</h3>
            <p class="mt-2 text-sm text-brun leading-relaxed">Un sac de substrat, un peu de patience et vous cultivez vos champignons à la maison.</p>
            <div class="mt-6 aspect-[4/3] overflow-hidden">
              <Image src={substratPic} alt="Sac de substrat en fructification" loading="lazy" decoding="async" widths={[320,480,640]} sizes="(min-width:768px) 400px, 100vw" formats={["avif","webp"]} class="w-full h-full object-cover" />
            </div>
            <div class="mt-6 flex flex-wrap justify-center gap-3">
              <a href={orderHref} target="_blank" rel="noopener" class="inline-flex items-center px-7 py-3.5 rounded-btn bg-violet text-page text-xs font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors">Commander</a>
              <a href="#culture" class="inline-flex items-center px-7 py-3.5 rounded-btn border-2 border-violet text-violet text-xs font-semibold tracking-wide uppercase hover:bg-violet/10 transition-colors">Comment faire ?</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Livraison & retrait -->
    <section class="px-6 md:px-10 py-12 md:py-16">
      <div class="max-w-7xl mx-auto">
        <div class="mb-14">
          <h2 class="font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] text-violet">
            Comment <em class="italic">recevoir</em> vos champignons ?
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">livraison &amp; retrait</p>
          <p class="mt-4 md:text-right font-title text-[clamp(1.6rem,3.5vw,2.8rem)] leading-[1.05] text-violet">3 étapes, c'est tout !</p>
        </div>

        <div class="grid md:grid-cols-3 gap-12 lg:gap-16 mb-20">
          <StepCard icon={etapeCommandeIcon} title="Vous commandez">
            En ligne via notre partenaire Pour de Bon ou en direct (mail ou insta) pour les volumes professionnels.
          </StepCard>
          <StepCard icon={etapeRecolteIcon} title="On récolte le matin">
            Cueillette quotidienne à la main, et conditionnement dans la foulée. Vos champignons n'attendent pas !
          </StepCard>
          <StepCard icon={etapeCartonIcon} title="Vos champignons sont là">
            Livraison ou retrait, vous choisissez, on s'adapte !
          </StepCard>
        </div>

        <DeliveryGrid variant="editorial" deliveryPrice="3,50€" />
      </div>
    </section>

    <!-- Cultiver chez soi : bande verte + panneau lilas 4 tips -->
    <section id="culture" class="py-4">
      <div class="grid md:grid-cols-2">
        <div class="bg-anis text-page px-6 md:px-10 lg:pl-20 py-14 md:py-20 flex flex-col justify-center text-right">
          <h2 class="font-title text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] text-cacao">
            <em class="italic">Lancez vous</em> dans la culture maison !
          </h2>
          <p class="mt-6 text-page leading-relaxed max-w-md ml-auto">
            C'est facile, même pour les débutants. En appartement ou en maison, aucune installation particulière n'est nécessaire. Chaque sac est vendu avec une fiche d'instructions claire et illustrée, pour vous accompagner pas à pas.
          </p>
          <div class="mt-8 aspect-[16/9] overflow-hidden max-w-md ml-auto">
            <Image src={cultureBandPic} alt="Substrat en fructification à la maison" loading="lazy" decoding="async" widths={[400,600,800]} sizes="(min-width:768px) 400px, 100vw" formats={["avif","webp"]} class="w-full h-full object-cover" />
          </div>
        </div>

        <div class="bg-lilas px-6 md:px-10 lg:pr-20 py-14 md:py-20 space-y-8">
          <div class="flex items-start gap-5">
            <FeatureIcon name="substrat" size="md" />
            <div>
              <h3 class="font-title text-xl text-cacao">Du substrat prêt à l'emploi</h3>
              <p class="mt-1 text-sm text-brun leading-relaxed">Fabriqué et ensemencé chez nous. Vous gardez la partie la plus sympa : voir pousser vos champignons.</p>
            </div>
          </div>
          <div class="flex items-start gap-5">
            <FeatureIcon name="humidite" size="md" />
            <div>
              <h3 class="font-title text-xl text-cacao">Un bonne humidité</h3>
              <p class="mt-1 text-sm text-brun leading-relaxed">Munissez-vous d'un brumisateur. Pschiiit pschiiit … maintenir l'humidité est primordial : sans elle, rien ne se passe.</p>
            </div>
          </div>
          <div class="flex items-start gap-5">
            <FeatureIcon name="air" size="md" />
            <div>
              <h3 class="font-title text-xl text-cacao">De l'air frais</h3>
              <p class="mt-1 text-sm text-brun leading-relaxed">Exposez le substrat à l'air frais. Évitez les espaces confinés et la proximité d'un chauffage.</p>
            </div>
          </div>
          <div class="flex items-start gap-5">
            <FeatureIcon name="patience" size="md" />
            <div>
              <h3 class="font-title text-xl text-cacao">Un peu de patience</h3>
              <p class="mt-1 text-sm text-brun leading-relaxed">Laissez le sac fermé jusqu'à l'apparition des primordias (petits champignons blancs), puis ouvrez. Quelques jours plus tard, c'est prêt !</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FaqCommune titleTone="violet" scriptTone="anis" />

    <CTASection
      variant="editorial"
      title="Envie de goûter ?"
      description="Passez-nous commande directement via Pour de Bon, ou contactez-nous pour les volumes pro."
      image={envieGouterPic}
      imageAlt="Dégustation de champignons poêlés"
      primaryCta={{ href: orderHref, label: "Commander en ligne" }}
      secondaryCta={{ href: "/contact", label: "Nous écrire" }}
    />
  </div>
</BaseLayout>
