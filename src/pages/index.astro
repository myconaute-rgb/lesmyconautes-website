---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import GammeCard from "../components/GammeCard.astro";
import StepCard from "../components/StepCard.astro";
import FAQItem from "../components/FAQItem.astro";
import CTASection from "../components/CTASection.astro";
import DeliveryGrid from "../components/DeliveryGrid.astro";
import MailLink from "../components/MailLink.astro";
import HoneypotField from "../components/HoneypotField.astro";
import Turnstile from "../components/Turnstile.astro";
import LocalBusinessLd from "../components/seo/LocalBusinessLd.astro";
import { VARIETIES } from "../data/varieties";

import universMaisonPic from "../assets/photos/univers-maison.jpg";
import universChefPic from "../assets/photos/univers-chef.jpg";
import universSubstratPic from "../assets/photos/univers-substrat.jpg";
import epiceriePicklesPic from "../assets/photos/epicerie-pickles.jpg";
import substratBlocPic from "../assets/photos/substrat-bloc.jpg";
import florestanPic from "../assets/photos/florestan-portrait.jpg";
import contactCagettePic from "../assets/photos/contact-cagette.jpg";
import envieGouterPic from "../assets/photos/envie-gouter.jpg";
import etapeCommandeIcon from "../assets/icons/etape-commande.png";
import etapeRecolteIcon from "../assets/icons/etape-recolte.png";
import etapeCartonIcon from "../assets/icons/etape-carton.png";

const byCode = Object.fromEntries(VARIETIES.map((v) => [v.varietyCode, v]));

/* Encarts gamme — maquette V2 : 3 + 3, sans lien, aplats charte.
   Titres/latins = casse maquette ; descriptions réelles conservées. */
const GAMME = [
  {
    title: "Pleurote gris",
    sub: "Pleurotus ostreatus",
    text: byCode.PLEUROTE.blurb,
    image: byCode.PLEUROTE.image!,
    imageAlt: byCode.PLEUROTE.imageAlt!,
    tone: "mauve",
  },
  {
    title: "Eryngii",
    sub: "Pleurotus eryngii",
    text: byCode.ERYNGII.blurb,
    image: byCode.ERYNGII.image!,
    imageAlt: byCode.ERYNGII.imageAlt!,
    tone: "jaune",
  },
  {
    title: "Black Pearl",
    sub: "Pleurotus ostreatus var. black pearl",
    text: byCode.BLACK_PEARL.blurb,
    image: byCode.BLACK_PEARL.image!,
    imageAlt: byCode.BLACK_PEARL.imageAlt!,
    tone: "bleu",
    badge: "Bientôt de retour !",
  },
  {
    title: "Hericium",
    sub: "hericium erinaceus",
    text: byCode.HERICIUM.blurb,
    image: byCode.HERICIUM.image!,
    imageAlt: byCode.HERICIUM.imageAlt!,
    tone: "sable",
    badge: "Bientôt de retour !",
  },
  {
    title: "Epicerie fine",
    sub: "du local en bocal",
    text: "Nos champignons travaillés en bocal à l'atelier : pickles d'eryngii, séchés et préparations de saison.",
    image: epiceriePicklesPic,
    imageAlt: "Pickles d'Eryngii — épicerie fine Les Myconautes",
    tone: "orange",
  },
  {
    title: "Substrat",
    sub: "pour cultiver chez soi",
    text: "Substrats inoculés certifiés bio, prêts à fructifier — pleurote, eryngii, hericium. Pour cultiver chez soi ou à la ferme.",
    image: substratBlocPic,
    imageAlt: "Sacs de substrat inoculé prêts à fructifier — Les Myconautes",
    tone: "anis",
  },
] as const;
---

<BaseLayout
  title="Les Myconautes — Champignons bio FR-BIO-01 | Rive-de-Gier, Loire"
  description="Champignonnière artisanale certifiée FR-BIO-01 à Rive-de-Gier (Loire). Pleurote, éryngii, hericium, Black Pearl. Producteur direct pour cuisine maison, restauration et substrats pros."
  skin="refonte"
>
  <LocalBusinessLd />

  <div class="bg-page font-body text-brun">
    <Hero />

    <!-- Nos univers -->
    <section id="univers" class="px-6 md:px-10 py-24 md:py-32">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16 reveal">
          <h2 class="font-title text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.02] text-violet">
            Des champignons <em class="italic">pour tous</em>, toute l'année.
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">nos univers</p>
          <p class="mt-8 max-w-3xl text-brun leading-relaxed">
            Vous aimez cuisiner à la maison ? Vous êtes Chef.fe d'un restaurant ? Acheteur.se pour une enseigne ? Vous produisez à la ferme ? <strong>On a ce qu'il vous faut !</strong>
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
          <a href="/particuliers" class="group block reveal">
            <div class="aspect-square overflow-hidden">
              <Image
                src={universMaisonPic}
                alt="Cuisiner les champignons à la maison"
                loading="lazy"
                decoding="async"
                widths={[320, 480, 640]}
                sizes="(min-width: 768px) 400px, 100vw"
                formats={["avif", "webp"]}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <p class="mt-6 text-sm text-brun leading-relaxed">
              Champignons frais, séchés, produits d'épicerie fine, et même des kits de culture pour les faire pousser …
            </p>
            <span class="mt-6 inline-flex items-center px-7 py-3.5 rounded-btn bg-violet text-page text-xs font-semibold tracking-wide uppercase group-hover:bg-violet/90 transition-colors">
              À la maison
            </span>
          </a>

          <a href="/pros" class="group block reveal">
            <div class="aspect-square overflow-hidden">
              <Image
                src={universChefPic}
                alt="Chef en cuisine — l'offre pro Les Myconautes"
                loading="lazy"
                decoding="async"
                widths={[320, 480, 640]}
                sizes="(min-width: 768px) 400px, 100vw"
                formats={["avif", "webp"]}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <p class="mt-6 text-sm text-brun leading-relaxed">
              Frais, en vrac ou conditionnés pour les rayons. Qualité constante de la production à la livraison.
            </p>
            <span class="mt-6 inline-flex items-center px-7 py-3.5 rounded-btn bg-cacao text-page text-xs font-semibold tracking-wide uppercase group-hover:bg-cacao/90 transition-colors">
              Offre pro
            </span>
          </a>

          <a href="/agriculteurs" class="group block reveal">
            <div class="aspect-square overflow-hidden">
              <Image
                src={universSubstratPic}
                alt="Sacs de substrat inoculé en fructification"
                loading="lazy"
                decoding="async"
                widths={[320, 480, 640]}
                sizes="(min-width: 768px) 400px, 100vw"
                formats={["avif", "webp"]}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <p class="mt-6 text-sm text-brun leading-relaxed">
              Substrats inoculés certifiés bio, mycélium et conseils techniques. Pleurote, eryngii, hericium, shiitake, nameko.
            </p>
            <span class="mt-6 inline-flex items-center px-7 py-3.5 rounded-btn bg-anis text-page text-xs font-semibold tracking-wide uppercase group-hover:bg-anis/90 transition-colors">
              Substrat
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Notre gamme — bande violette signature à gauche -->
    <section id="gamme" class="relative py-24 md:py-32 overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-8 lg:w-20 bg-violet hidden md:block" aria-hidden="true"></div>
      <div class="max-w-7xl mx-auto px-6 md:px-10 lg:pl-32">
        <div class="mb-16 reveal">
          <h2 class="font-title text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.02] text-violet">
            Cultivés avec soin, récoltés <em class="italic">à la main</em>.
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">notre gamme</p>
          <p class="mt-8 max-w-3xl text-brun leading-relaxed">
            Traçabilité et fraîcheur garantie ! Toutes nos variétés sont cultivées à partir de notre propre substrat, et certifiées FR-BIO-01. Nos champignons français sont récoltés tous les matins à la main, puis conditionnés dans la foulée.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {GAMME.map((c) => (
            <div class="reveal">
              <GammeCard {...c} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Explorateurs du champignon depuis 2015 -->
    <section id="about" class="py-24 md:py-32">
      <div class="grid md:grid-cols-2">
        <div class="flex flex-col justify-center">
          <div class="px-6 md:px-10 lg:pl-20 pb-12 reveal">
            <h2 class="font-title text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.02] text-violet">
              Explorateurs du champignon <em class="italic">depuis 2015</em>
            </h2>
          </div>

          <div class="bg-lilas px-6 md:px-10 lg:pl-20 py-12 md:py-16 reveal">
            <p class="text-brun leading-relaxed max-w-md">
              Florestan a fondé sa première champignonnière en 2015. Dix ans plus tard, c'est un refuge pour la biodiversité de 1,7 hectare niché à Rive-de-Gier, dans la Loire.
            </p>
            <p class="mt-4 text-brun leading-relaxed max-w-md">
              Chaque champignon est cultivé, récolté à la main et conditionné ici même. Circuit court strict : vous savez d'où vient ce que vous mangez.
            </p>

            <a
              href="/myconautes"
              class="mt-10 inline-flex items-center text-center px-8 py-4 rounded-btn bg-violet text-page text-sm font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors"
            >
              En apprendre +<br />sur les Myconautes
            </a>
          </div>
        </div>

        <div class="relative min-h-[420px] md:min-h-0">
          <Image
            src={florestanPic}
            alt="Florestan, fondateur des Myconautes, avec une brassée de champignons"
            loading="lazy"
            decoding="async"
            widths={[400, 600, 800, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={["avif", "webp"]}
            class="absolute inset-0 w-full h-full object-cover object-top"
          />
          <div class="absolute inset-y-0 right-0 w-6 lg:w-12 bg-violet" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- Livraison & retrait -->
    <section id="livraison" class="px-6 md:px-10 py-24 md:py-32">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16 reveal">
          <h2 class="font-title text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.02] text-violet">
            Comment <em class="italic">recevoir</em> vos champignons ?
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">livraison &amp; retrait</p>
          <p class="mt-4 md:text-right font-title text-[clamp(1.6rem,3.5vw,2.8rem)] leading-[1.05] text-violet">
            3 étapes, c'est tout !
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-12 lg:gap-16 mb-20">
          <div class="reveal">
            <StepCard icon={etapeCommandeIcon} title="Vous commandez">
              En ligne via notre partenaire Pour de Bon ou en direct (mail ou insta) pour les volumes professionnels.
            </StepCard>
          </div>
          <div class="reveal">
            <StepCard icon={etapeRecolteIcon} title="On récolte le matin">
              Cueillette quotidienne à la main, et conditionnement dans la foulée. Vos champignons n'attendent pas !
            </StepCard>
          </div>
          <div class="reveal">
            <StepCard icon={etapeCartonIcon} title="Vos champignons sont là">
              Livraison ou retrait, vous choisissez, on s'adapte !
            </StepCard>
          </div>
        </div>

        <div class="reveal">
          <DeliveryGrid variant="editorial" />
        </div>
      </div>
    </section>

    <!-- FAQ — bande violette signature à gauche -->
    <section id="faq" class="relative py-24 md:py-32 overflow-hidden">
      <div class="absolute inset-y-0 left-0 w-8 lg:w-40 bg-violet hidden md:block" aria-hidden="true"></div>
      <div class="max-w-4xl mx-auto px-6 md:px-10">
        <div class="mb-12 reveal">
          <h2 class="font-title text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.02] text-violet">
            Tout <em class="italic">savoir</em> sur nos champignons
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">questions fréquentes</p>
        </div>

        <div class="bg-creme/60 px-6 md:px-10 py-8 reveal">
          <div class="mb-8">
            <div class="flex items-center gap-2 pb-3 mb-2 border-b border-terracotta/30 text-xs font-semibold uppercase tracking-widest text-terracotta">
              <span>🍄 Nos produits</span>
            </div>
            <FAQItem variant="editorial" question="Vos champignons sont-ils bio ?">
              Tous nos champignons sont issus de l'agriculture biologique (label FR-BIO-01) et cultivés selon des pratiques durables et raisonnées.
            </FAQItem>
            <FAQItem variant="editorial" question="D'où viennent vos champignons ?">
              Cultivés, récoltés et conditionnés à Rive-de-Gier (Loire). Circuit court, sans intermédiaire.
            </FAQItem>
            <FAQItem variant="editorial" question="Faut-il les laver ?">
              Nos champignons sont propres et parés. Un simple essuyage avec un linge humide suffit.
            </FAQItem>
          </div>

          <div class="mb-8">
            <div class="flex items-center gap-2 pb-3 mb-2 border-b border-terracotta/30 text-xs font-semibold uppercase tracking-widest text-terracotta">
              <span>❄️ Conservation</span>
            </div>
            <FAQItem variant="editorial" question="Combien de temps se conservent-ils ?">
              8 à 10 jours au réfrigérateur (0 à 4°C), dans leur emballage d'origine ou un contenant aéré.
            </FAQItem>
            <FAQItem variant="editorial" question="Puis-je les congeler ?">
              Préférez les poêler légèrement avant congélation pour préserver texture et goût.
            </FAQItem>
          </div>

          <div>
            <div class="flex items-center gap-2 pb-3 mb-2 border-b border-terracotta/30 text-xs font-semibold uppercase tracking-widest text-terracotta">
              <span>📦 Retrait &amp; livraison</span>
            </div>
            <FAQItem variant="editorial" question="Puis-je récupérer ma commande ?">
              Oui — retrait gratuit au 5 rue Vallée de Couzon, 42800 Rive-de-Gier, du lundi au vendredi de 7h à 13h. Conservation au frais 3 jours.
            </FAQItem>
            <FAQItem variant="editorial" question="Livrez-vous les particuliers en dehors de Lyon et Saint-Étienne ?">
              Pour la France entière, passez par Pour de Bon. Pour les volumes pro, on étudie au cas par cas — contactez-nous.
            </FAQItem>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="px-6 md:px-10 py-24 md:py-32">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 lg:gap-20">
        <div class="reveal">
          <h2 class="font-title text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] text-cacao">
            Encore une <em class="italic">question</em> ?
          </h2>
          <p class="script-sub text-[clamp(1.6rem,3vw,2.2rem)] text-anis">contact</p>
          <p class="mt-8 text-brun leading-relaxed">
            Que ce soit pour partager une recette, obtenir nos tarifs &amp; conditions de vente, demander des détails techniques sur nos substrats ou nous avouer que vous adorez nos champignons … on vous répond !
          </p>

          <form class="mt-10 grid gap-5" data-contact-form>
            <HoneypotField />
            <div>
              <label for="cf-name" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Nom</label>
              <input id="cf-name" name="name" type="text" required class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
            </div>
            <div>
              <label for="cf-email" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Email</label>
              <input id="cf-email" name="email" type="email" required class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
            </div>
            <div>
              <label for="cf-phone" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Téléphone</label>
              <input id="cf-phone" name="phone" type="tel" class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
            </div>
            <div>
              <label for="cf-postal" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Code postal</label>
              <input id="cf-postal" name="postal_code" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" placeholder="42800" class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
              <p class="text-xs text-brun/60 mt-1.5">Sert à estimer les frais de transport (facultatif).</p>
            </div>
            <div>
              <label for="cf-msg" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Message</label>
              <textarea id="cf-msg" name="message" rows="4" required class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm resize-y"></textarea>
            </div>
            <Turnstile />
            <button type="submit" class="justify-self-start inline-flex items-center px-8 py-4 rounded-btn bg-cacao text-page text-sm font-semibold tracking-wide uppercase hover:bg-cacao/90 transition-colors">
              Envoyer
            </button>
            <p class="text-xs text-brun/60 leading-relaxed">
              En envoyant ce formulaire, vous acceptez que vos données soient utilisées pour répondre à votre demande. <a href="/mentions-legales" class="underline hover:text-violet">Plus d'infos</a>.
            </p>
            <p class="hidden text-sm text-anis font-semibold" data-form-success>
              Merci, votre message est parti. On vous répond très vite.
            </p>
            <p class="hidden text-sm text-terracotta font-semibold" data-form-error>
              Une erreur est survenue. Réessayez, ou écrivez directement à <span class="underline">myconaute &#x40; pm.me</span>.
            </p>
          </form>
        </div>

        <!-- Bloc photo « contact » (maquette V2) : cagette + infos sur aplat cacao -->
        <div class="reveal">
          <div class="h-full flex flex-col">
            <Image
              src={contactCagettePic}
              alt="Cagette de pleurotes fraîchement récoltés — Les Myconautes"
              loading="lazy"
              decoding="async"
              widths={[480, 720, 1040]}
              sizes="(min-width: 768px) 50vw, 100vw"
              formats={["avif", "webp"]}
              class="w-full object-cover aspect-[2/1]"
            />
            <div class="bg-cacao text-page px-8 md:px-12 py-12 grow">
              <ul class="space-y-7">
                <li class="flex items-center gap-5">
                  <svg class="w-9 h-9 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" />
                  </svg>
                  <p class="text-base md:text-lg">5 rue vallée de Couzon<br />42800 Rive-de-Gier</p>
                </li>
                <li class="flex items-center gap-5">
                  <svg class="w-9 h-9 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                  </svg>
                  <p class="text-base md:text-lg">Ouvert du lundi au vendredi<br />De 7h à 13h</p>
                </li>
                <li class="flex items-center gap-5">
                  <svg class="w-9 h-9 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                  </svg>
                  <p class="text-base md:text-lg"><MailLink email="myconautes@pm.me" /></p>
                </li>
                <li class="flex items-center gap-5">
                  <svg class="w-9 h-9 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
                  </svg>
                  <p class="text-base md:text-lg"><a href="https://www.instagram.com/les_myconautes/" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-lilas transition-colors">@les_myconautes</a></p>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTASection
      variant="editorial"
      title="Envie de goûter ?"
      description="Passez-nous commande directement via Pour de Bon, ou contactez-nous pour les volumes pro."
      image={envieGouterPic}
      imageAlt="Dégustation de champignons poêlés"
    />
  </div>
</BaseLayout>

<script>
  import { wireContactForm } from "../scripts/contact-form";
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) wireContactForm(form, "contact_home");
</script>

<script>
  // Révélation discrète au scroll — fondu + léger déplacement, coupée si
  // l'utilisateur préfère réduire les animations.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const items = document.querySelectorAll(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px" }
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
