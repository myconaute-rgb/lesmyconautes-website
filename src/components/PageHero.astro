---
interface Props {
  /** Couleur dominante de la page (variante v1 uniquement). */
  theme?: "lavande" | "terracotta" | "turquoise";
  label: string;
  title: string;
  /** Mot ou portion mise en italique dans le H1. */
  highlight?: string;
  description: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  /** "refonte" = DA 07/2026 (titre Anton violet, sous-titre script vert). Défaut : historique. */
  variant?: "v1" | "refonte";
  /** Couleur du titre en variante refonte (agriculteurs = anis). Défaut : violet. */
  titleTone?: "violet" | "anis";
}

const { theme = "lavande", label, title, highlight, description, primaryCta, secondaryCta, variant = "v1", titleTone = "violet" } = Astro.props;
const refonte = variant === "refonte";

const titleColor = titleTone === "anis" ? "text-anis" : "text-violet";
const scriptColor = titleTone === "anis" ? "text-violet" : "text-anis";

function splitHighlight(t: string, h?: string) {
  if (!h) return [t, "", ""];
  const i = t.indexOf(h);
  if (i === -1) return [t, "", ""];
  return [t.slice(0, i), h, t.slice(i + h.length)];
}
const [pre, hi, post] = splitHighlight(title, highlight);

const bg = {
  lavande: "bg-lavande",
  terracotta: "bg-terracotta",
  turquoise: "bg-turquoise",
}[theme];

const labelText = {
  lavande: "text-ivoire/85",
  terracotta: "text-ivoire/90",
  turquoise: "text-brun/85",
}[theme];

const titleText = {
  lavande: "text-ivoire",
  terracotta: "text-ivoire",
  turquoise: "text-brun",
}[theme];

const descriptionText = {
  lavande: "text-ivoire/85",
  terracotta: "text-ivoire/90",
  turquoise: "text-brun-clair",
}[theme];

const isLightTheme = theme === "turquoise";
const primaryClass = isLightTheme
  ? "bg-brun text-ivoire hover:brightness-110"
  : "bg-ivoire text-brun hover:brightness-95";
const secondaryClass = isLightTheme
  ? "border-brun/30 text-brun hover:bg-brun/10"
  : "border-ivoire/40 text-ivoire hover:bg-ivoire/10";
---

{refonte ? (
  <section class="bg-page font-body px-6 md:px-10 pt-14 md:pt-20 pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto">
      <h1 class={`font-title text-[clamp(2.6rem,6.5vw,5.5rem)] leading-[0.98] ${titleColor}`}>
        {pre}{hi && <em class="italic">{hi}</em>}{post}
      </h1>
      <p class={`script-sub text-[clamp(1.6rem,3vw,2.4rem)] ${scriptColor}`}>{label}</p>
      <p class="mt-8 max-w-2xl text-brun leading-relaxed">{description}</p>

      {(primaryCta || secondaryCta) && (
        <div class="mt-10 flex flex-wrap gap-4">
          {primaryCta && (
            <a
              href={primaryCta.href}
              target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
              rel={primaryCta.href.startsWith("http") ? "noopener" : undefined}
              class="inline-flex items-center px-8 py-4 rounded-btn bg-violet text-page text-sm font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors"
            >
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-violet text-violet text-sm font-semibold tracking-wide uppercase hover:bg-violet/10 transition-colors"
            >
              {secondaryCta.label}
            </a>
          )}
        </div>
      )}
    </div>
  </section>
) : (
<section class={`${bg} px-6 py-14 md:py-20 relative overflow-hidden`}>
  <!-- disques décoratifs -->
  <div class="absolute -top-16 -left-16 w-64 h-64 rounded-full bg-ivoire/10 mix-blend-overlay"></div>
  <div class="absolute -bottom-20 -right-20 w-80 h-80 rounded-full bg-brun/10 mix-blend-multiply"></div>

  <div class="relative max-w-4xl mx-auto text-center">
    <span class={`inline-block text-xs font-semibold tracking-widest uppercase ${labelText}`}>
      {label}
    </span>
    <h1 class={`mt-3 text-4xl md:text-5xl leading-[1.1] ${titleText}`}>
      {(() => {
        if (!highlight) return title;
        const idx = title.indexOf(highlight);
        if (idx === -1) return title;
        return (
          <>
            {title.slice(0, idx)}
            <em class="italic">{highlight}</em>
            {title.slice(idx + highlight.length)}
          </>
        );
      })()}
    </h1>
    <p class={`mt-5 max-w-2xl mx-auto leading-relaxed ${descriptionText}`}>
      {description}
    </p>

    {(primaryCta || secondaryCta) && (
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {primaryCta && (
          <a
            href={primaryCta.href}
            target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
            rel={primaryCta.href.startsWith("http") ? "noopener" : undefined}
            class={`inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold transition shadow-sm ${primaryClass}`}
          >
            {primaryCta.label} <span aria-hidden="true">→</span>
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class={`inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 font-semibold transition ${secondaryClass}`}
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
)}
