---
/**
 * Section contact partagée — DA maquettes v3 (Aline).
 * Formulaire (nom/email/tél/CP/message) + bloc cacao (adresse, horaires,
 * email, insta) sur photo cagette. Titre « Encore une question ? » cacao,
 * script violet. Réutilisée sur pro et la page contact (l'accueil garde son
 * bloc inline, fonctionnellement identique).
 *
 * Validation : name + email requis. `messageRequired` contrôle le message
 * (facultatif côté pro/agri, obligatoire pour le tout-public — cf. ANTI_BUGS §92,
 * le serveur n8n n'exige de toute façon que name+email).
 */
import { Image } from "astro:assets";
import MailLink from "./MailLink.astro";
import HoneypotField from "./HoneypotField.astro";
import Turnstile from "./Turnstile.astro";
import type { ContactFormType } from "../scripts/contact-form";
import contactDemiPagePic from "../assets/photos/contact-demi-page.jpg";

interface Props {
  formType: ContactFormType;
  intro: string;
  messageRequired?: boolean;
  scriptTone?: "anis" | "violet";
  /** "h1" quand la section est le titre principal de la page (page contact). */
  headingLevel?: "h1" | "h2";
}
const { formType, intro, messageRequired = false, scriptTone = "violet", headingLevel = "h2" } = Astro.props;
const scriptColor = scriptTone === "anis" ? "text-anis" : "text-violet";
const Heading = headingLevel;
---

<section id="contact" class="px-6 md:px-10 py-14 md:py-20 font-body">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 lg:gap-20">
    <div>
      <Heading class="font-title text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] text-cacao">
        Encore une <em class="italic">question</em> ?
      </Heading>
      <p class={`script-sub text-[clamp(1.6rem,3vw,2.2rem)] ${scriptColor}`}>contact</p>
      <p class="mt-8 text-brun leading-relaxed">{intro}</p>

      <form class="mt-10 grid gap-5" data-contact-form data-form-type={formType}>
        <HoneypotField />
        <div>
          <label for="cf-name" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Nom</label>
          <input id="cf-name" name="name" type="text" required class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
        </div>
        <div>
          <label for="cf-email" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Email</label>
          <input id="cf-email" name="email" type="email" required class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
        </div>
        <div>
          <label for="cf-phone" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Téléphone</label>
          <input id="cf-phone" name="phone" type="tel" class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
        </div>
        <div>
          <label for="cf-postal" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Code postal</label>
          <input id="cf-postal" name="postal_code" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" placeholder="42800" class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm" />
          <p class="text-xs text-brun/60 mt-1.5">Sert à estimer les frais de transport (facultatif).</p>
        </div>
        <div>
          <label for="cf-msg" class="block text-xs font-semibold uppercase tracking-wider text-brun mb-1.5">Message</label>
          <textarea id="cf-msg" name="message" rows="4" required={messageRequired} class="w-full px-4 py-3.5 rounded-btn bg-ivoire border border-brun/15 focus:border-violet focus:outline-none text-sm resize-y"></textarea>
        </div>
        <Turnstile />
        <button type="submit" class="justify-self-start inline-flex items-center px-8 py-4 rounded-btn bg-cacao text-page text-sm font-semibold tracking-wide uppercase hover:bg-cacao/90 transition-colors">
          Envoyer
        </button>
        <p class="text-xs text-brun/60 leading-relaxed">
          <slot name="consent">En envoyant ce formulaire, vous acceptez que vos données soient utilisées pour répondre à votre demande. <a href="/mentions-legales" class="underline hover:text-violet">Plus d'infos</a>.</slot>
        </p>
        <p class="hidden text-sm text-anis font-semibold" data-form-success>
          Merci, votre message est parti. On vous répond très vite.
        </p>
        <p class="hidden text-sm text-terracotta font-semibold" data-form-error>
          Une erreur est survenue. Réessayez, ou écrivez directement à <span class="underline">myconaute &#x40; pm.me</span>.
        </p>
      </form>
    </div>

    <!-- Patch DA 25/07 : visuel « demi-page contact » fourni par Florestan. Il
         embarque la photo ET le pavé cacao (adresse, horaires, mail, insta).
         Les mêmes informations restent dans le DOM juste après, en sr-only :
         lecteurs d'écran, référencement local et lien mailto conservés. -->
    <div>
      <Image
        src={contactDemiPagePic}
        alt="Cagette de pleurotes portée à bout de bras, et nos coordonnées : 5 rue vallée de Couzon, 42800 Rive-de-Gier — ouvert du lundi au vendredi de 7h à 13h."
        loading="lazy"
        decoding="async"
        widths={[480, 720, 1040, 1400]}
        sizes="(min-width: 768px) 50vw, 100vw"
        formats={["avif", "webp"]}
        class="w-full h-auto"
      />
      <address class="sr-only not-italic">
        <p>5 rue vallée de Couzon, 42800 Rive-de-Gier</p>
        <p>Ouvert du lundi au vendredi, de 7h à 13h</p>
        <p><MailLink email="myconautes@pm.me" /></p>
        <p><a href="https://www.instagram.com/les_myconautes/" target="_blank" rel="noopener">@les_myconautes</a></p>
      </address>
    </div>
  </div>
</section>

<script>
  import { wireContactForm, type ContactFormType } from "../scripts/contact-form";
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const t = (form.dataset.formType ?? "contact") as ContactFormType;
    wireContactForm(form, t);
  }
</script>
