---
/**
 * Icône « bulle violette » — DA maquettes v3 (Aline) : pictogramme blanc
 * dans une bulle violette. Cercle par défaut (avantages / valeurs),
 * carré arrondi possible (conseils conservation).
 */
interface Props {
  name:
    | "bio" | "francais" | "main" | "durable" | "circuit"
    | "conditionnement" | "volumes" | "livraison" | "tarifs"
    | "temperature" | "atmosphere" | "duree" | "congelation";
  shape?: "circle" | "square";
  size?: "md" | "lg";
}
const { name, shape = "circle", size = "lg" } = Astro.props;

const box = size === "lg" ? "w-16 h-16" : "w-12 h-12";
const radius = shape === "square" ? "rounded-2xl" : "rounded-full";
const stroke = "1.6";
---

<span class={`inline-flex items-center justify-center ${box} ${radius} bg-violet text-page`}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" class="w-1/2 h-1/2" aria-hidden="true">
    {name === "bio" && (<>
      <path d="M12 20s-6-3.5-6-9a6 6 0 0 1 12 0c0 5.5-6 9-6 9Z" />
      <path d="M12 11c0-2 1.4-3.4 3.2-3.6C15 9.4 13.6 11 12 11Zm0 0c0-2-1.4-3.4-3.2-3.6C9 9.4 10.4 11 12 11Z" />
    </>)}
    {name === "francais" && (<>
      <path d="M5 3v18" />
      <path d="M5 4h13l-2.5 4L18 12H5" />
    </>)}
    {name === "main" && (<>
      <path d="M6 12V7a1.5 1.5 0 0 1 3 0v4" />
      <path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11" />
      <path d="M12 11V6.5a1.5 1.5 0 0 1 3 0V12" />
      <path d="M15 12v-1a1.5 1.5 0 0 1 3 0v4a5 5 0 0 1-5 5h-1.5a4 4 0 0 1-3.1-1.5L5 15" />
    </>)}
    {name === "durable" && (<>
      <path d="M4 8a8 8 0 0 1 13-2.5M20 6v4h-4" />
      <path d="M20 16a8 8 0 0 1-13 2.5M4 18v-4h4" />
    </>)}
    {name === "circuit" && (<>
      <path d="M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10Z" />
      <circle cx="12" cy="11" r="2.2" />
    </>)}
    {name === "conditionnement" && (<>
      <path d="M3 8.5 12 4l9 4.5v7L12 20 3 15.5v-7Z" />
      <path d="m3 8.5 9 4.5 9-4.5M12 13v7" />
    </>)}
    {name === "volumes" && (<>
      <rect x="4" y="5" width="16" height="16" rx="2" />
      <path d="M4 9h16M8 3v4M16 3v4M8 13h3M8 17h6" />
    </>)}
    {name === "livraison" && (<>
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" />
      <circle cx="7" cy="18" r="1.6" /><circle cx="17.5" cy="18" r="1.6" />
    </>)}
    {name === "tarifs" && (<>
      <path d="M4 12V5a1 1 0 0 1 1-1h7l8 8-8 8-8-8Z" />
      <circle cx="8.5" cy="8.5" r="1.2" />
    </>)}
    {name === "temperature" && (<>
      <path d="M10 13V5a2 2 0 0 1 4 0v8a4 4 0 1 1-4 0Z" />
      <path d="M12 13V8" />
    </>)}
    {name === "atmosphere" && (
      <path d="M12 3s5 6 5 10a5 5 0 0 1-10 0c0-4 5-10 5-10Z" />
    )}
    {name === "duree" && (<>
      <circle cx="12" cy="12" r="8" /><path d="M12 8v4l3 2" />
    </>)}
    {name === "congelation" && (<>
      <path d="M12 2v20M4 6l16 12M20 6 4 18" />
      <path d="M12 5 9.5 7M12 5l2.5 2M12 19l-2.5-2M12 19l2.5-2M5.5 8l.4 2.9M5.5 8 3 8.7M18.5 16l-.4-2.9M18.5 16 21 15.3M18.5 8l-.4 2.9M18.5 8 21 8.7M5.5 16l.4-2.9M5.5 16 3 15.3" />
    </>)}
  </svg>
</span>
