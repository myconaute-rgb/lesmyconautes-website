---
/**
 * Hero accueil — DA « refonte » 07/2026 (maquettes 1 & 2).
 * Titre-affiche Anton pleine largeur, puis bandeau en deux volets :
 * visuel à gauche (emplacement prêt pour une future photo), aplat
 * violet à droite avec le texte et les CTA. Contenus inchangés.
 */
interface Props {
  badge?: string;
  title?: string;
  highlight?: string;
  description?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const {
  badge = "Frais du jour · Lyon",
  title = "Explorez le monde des",
  highlight = "champignons",
  description = "Cultivés, récoltés à la main et conditionnés chaque jour à Rive-de-Gier (Loire). Pour la cuisine maison, la restauration et la production agricole.",
  primaryCta = { href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander en ligne" },
  secondaryCta = { href: "#univers", label: "Découvrir nos univers" },
} = Astro.props;
---

<section class="bg-page font-body">
  <!-- Titre-affiche -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-10 md:pb-14">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-anis">
      {badge}
    </p>
    <h1 class="mt-4 font-title text-[clamp(2.6rem,7.5vw,6.5rem)] leading-[0.98] text-violet">
      {title} <em class="italic">{highlight}</em>
    </h1>
  </div>

  <!-- Bandeau deux volets -->
  <div class="grid md:grid-cols-2">
    <!-- Volet visuel : aplat lilas, prêt à accueillir une photo pleine hauteur -->
    <div class="relative bg-lilas min-h-[320px] md:min-h-[520px] flex items-center justify-center overflow-hidden">
      <img
        src="/scaphandre-logo.svg"
        alt="Logo scaphandre Les Myconautes"
        class="w-2/3 max-w-xs md:max-w-sm object-contain opacity-90"
      />
    </div>

    <!-- Volet violet : texte + CTA -->
    <div class="bg-violet text-page px-8 md:px-16 py-14 md:py-20 flex flex-col justify-center">
      <p class="text-base md:text-lg leading-relaxed max-w-md">
        {description}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={primaryCta.href}
          target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
          rel={primaryCta.href.startsWith("http") ? "noopener" : undefined}
          class="inline-flex items-center px-8 py-4 rounded-btn bg-page text-violet text-sm font-semibold tracking-wide uppercase hover:bg-page/90 transition-colors"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-page/70 text-page text-sm font-semibold tracking-wide uppercase hover:bg-page/10 transition-colors"
        >
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>
