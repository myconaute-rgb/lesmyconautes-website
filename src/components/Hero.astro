---
/**
 * Hero accueil — maquette-corps-page-accueil (brief V2 16/07).
 * Titre-affiche Anton pleine largeur, puis bandeau deux volets :
 * photo cagette à gauche, aplat violet à droite avec la ligne script
 * « bio . locaux . délicieux », le texte en deux temps et les CTA.
 */
import { Image } from "astro:assets";
import heroCagettePic from "../assets/photos/hero-cagette-eryngii.jpg";
import bandeauPic from "../assets/photos/bandeau-eryngii.jpg";

interface Props {
  title?: string;
  highlight?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const {
  title = "Explorez le monde des",
  highlight = "champignons",
  primaryCta = { href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander en ligne" },
  secondaryCta = { href: "#univers", label: "Découvrir nos univers" },
} = Astro.props;
---

<section class="bg-page font-body">
  <!-- Titre-affiche -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 md:pt-14 pb-10 md:pb-14">
    <h1 class="font-title text-[clamp(2.6rem,7.5vw,6.5rem)] leading-[0.98] text-violet">
      {title} <em class="italic">{highlight}</em>
    </h1>
  </div>

  <!-- Bandeau photo pleine largeur (patch DA 25/07), commun à toutes les pages -->
  <div class="relative h-64 md:h-96 overflow-hidden">
    <Image
      src={bandeauPic}
      alt="Cagette d'eryngii fraîchement récoltés — Les Myconautes"
      loading="eager"
      decoding="async"
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      formats={["avif", "webp"]}
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Bandeau deux volets -->
  <div class="grid md:grid-cols-2">
    <!-- Volet visuel : cagette d'eryngii sur fond crème (photo maquette) -->
    <div class="relative bg-page min-h-[320px] md:min-h-[520px] overflow-hidden">
      <Image
        src={heroCagettePic}
        alt="Cagette d'eryngii frais — Les Myconautes"
        loading="eager"
        decoding="async"
        widths={[480, 720, 1024, 1440, 1920]}
        sizes="(min-width: 768px) 50vw, 100vw"
        formats={["avif", "webp"]}
        class="absolute inset-0 w-full h-full object-cover object-bottom"
      />
    </div>

    <!-- Volet violet : script + texte + CTA -->
    <div class="bg-violet text-page px-8 md:px-16 py-14 md:py-20 flex flex-col justify-center">
      <p class="font-script uppercase tracking-[0.02em] text-[clamp(1.8rem,3.5vw,2.6rem)] leading-tight">
        bio . locaux . délicieux
      </p>
      <p class="mt-8 text-base md:text-lg leading-relaxed max-w-md">
        Cultivés avec soin, récoltés à la main, conditionnés chaque jour ici, à Rive-de-Gier, dans la Loire.
      </p>
      <p class="mt-4 text-base md:text-lg leading-relaxed max-w-md">
        Pour la cuisine maison, la restauration et la production agricole.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={primaryCta.href}
          target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
          rel={primaryCta.href.startsWith("http") ? "noopener" : undefined}
          class="inline-flex items-center px-8 py-4 rounded-btn bg-page text-violet text-sm font-semibold tracking-wide uppercase hover:bg-page/90 transition-colors"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-page/70 text-page text-sm font-semibold tracking-wide uppercase hover:bg-page/10 transition-colors"
        >
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>
