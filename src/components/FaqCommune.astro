---
/**
 * FAQ commune — accueil, particuliers, pros, myconautes.
 *
 * Le bloc était copié-collé à l'identique sur les 4 pages : il est factorisé ici
 * depuis le patch DA du 25/07/2026, qui demandait la même réécriture partout
 * (congélation, retrait, livraison hors Lyon / Saint-Étienne). Les seules
 * variations d'une page à l'autre sont les couleurs du titre et du sous-titre.
 *
 * Éditeur du site, lot L1 : les mots vivent dans contenu/site/partages/faq.json
 * (règle R92 : aucun texte en dur ici). Les pages pas encore migrées passent
 * toujours leurs couleurs et leur ancre en paramètres (K15).
 */
import FAQItem from "./FAQItem.astro";
import { chargerPartage, contexteTexte } from "../contenu/charger.ts";
import { REGLES } from "../contenu/schema.ts";
import { rendreTexte } from "../contenu/texte.ts";

interface Props {
  /** Couleur du titre Anton : violet (accueil, particuliers, myconautes) ou cacao (pros). */
  titleTone?: "violet" | "cacao";
  /** Couleur du sous-titre script. */
  scriptTone?: "anis" | "violet";
  /** id d'ancre de la section (l'accueil expose #faq). */
  id?: string;
}
const { titleTone = "violet", scriptTone = "anis", id } = Astro.props;
const titleColor = titleTone === "cacao" ? "text-cacao" : "text-violet";
const scriptColor = scriptTone === "violet" ? "text-violet" : "text-anis";
const catClass =
  "flex items-center gap-2 pb-3 mb-2 border-b border-terracotta/30 text-xs font-semibold uppercase tracking-widest text-terracotta";

const faq = chargerPartage("faq");
const ctx = contexteTexte({ classeLien: "underline underline-offset-4 hover:text-violet" });
const html = (s: string, regles: (typeof REGLES)[keyof typeof REGLES]) => rendreTexte(s, regles, ctx);
// La réponse arrive dans le <slot> de FAQItem entourée des mêmes blancs qu'avant la
// migration : le HTML produit reste identique (le comparateur ne tolère aucun écart d'espaces).
const avantReponse = "\n          ";
const apresReponse = "\n        ";
const derniere = faq.rubriques.length - 1;
---

<section id={id} class="relative py-14 md:py-20 overflow-hidden">
  <div class="absolute inset-y-0 left-0 w-8 lg:w-40 bg-violet hidden md:block" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto px-6 md:px-10">
    <div class="mb-10">
      <h2 class={`font-title text-[clamp(2rem,5vw,4rem)] leading-[1.02] ${titleColor}`} set:html={html(faq.titre, REGLES.titre)} />
      {faq.sousTitre && (
        <p class={`script-sub text-[clamp(1.6rem,3vw,2.2rem)] ${scriptColor}`} set:html={html(faq.sousTitre, REGLES.script)} />
      )}
    </div>

    <div class="bg-creme/60 px-6 md:px-10 py-8">
      {faq.rubriques.map((rubrique, i) => (
        <div class={i < derniere ? "mb-8" : undefined}>
          <div class={catClass}><span set:html={html(rubrique.titre, REGLES.libelle)} /></div>
          {rubrique.questions.map((q) => (
            <FAQItem variant="editorial" question={q.question}>
              <Fragment set:html={avantReponse + html(q.reponse, REGLES.paragraphe) + apresReponse} />
            </FAQItem>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
