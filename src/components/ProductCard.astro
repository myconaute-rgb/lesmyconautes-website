---
import { Image } from "astro:assets";
import type { Variety } from "../data/varieties";

interface Props {
  variety: Variety;
  href?: string;
  /** Lazy par défaut. Mets "eager" pour les cards above-the-fold (hero). */
  loading?: "lazy" | "eager";
}

const { variety, href = `/varietes/${variety.slug}`, loading = "lazy" } = Astro.props;

const accentTextClass = {
  lavande: "text-violet-profond",
  terracotta: "text-terracotta",
  turquoise: "text-turquoise",
  "violet-profond": "text-violet-profond",
}[variety.accent];

const hasImage = !!variety.image;
const altText = variety.imageAlt ?? `${variety.name} (${variety.latin})`;
const isOffSeason = !!variety.tag;
---

<a
  href={href}
  class={`group block bg-ivoire rounded-2xl overflow-hidden ring-1 ring-brun/5 hover:ring-brun/15 hover:-translate-y-1 transition shadow-sm hover:shadow-md ${isOffSeason ? "opacity-95" : ""}`}
>
  <div class={`aspect-square relative overflow-hidden ${hasImage ? "bg-creme" : `bg-gradient-to-br ${variety.gradient}`}`}>
    {hasImage && variety.image ? (
      <Image
        src={variety.image}
        alt={altText}
        loading={loading}
        decoding="async"
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 768px) 320px, (min-width: 480px) 480px, 100vw"
        formats={["avif", "webp"]}
        class={`w-full h-full object-cover transition-transform duration-500 ${isOffSeason ? "saturate-50 group-hover:saturate-75" : "group-hover:scale-105"}`}
      />
    ) : (
      <span class="absolute inset-0 flex items-center justify-center text-6xl drop-shadow-sm" aria-hidden="true">
        {variety.emoji}
      </span>
    )}
    {variety.tag && (
      <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-lavande/95 text-ivoire text-xs font-semibold uppercase tracking-wider shadow-sm backdrop-blur-sm">
        🟣 {variety.tag}
      </span>
    )}
  </div>
  <div class="p-5">
    <h3 class="font-display text-lg text-brun">{variety.name}</h3>
    <p class="font-display italic text-xs text-brun-clair/70 mt-0.5">{variety.latin}</p>
    <p class="mt-3 text-sm text-brun-clair leading-relaxed">{variety.blurb}</p>
    <span class={`mt-4 inline-block text-xs font-semibold uppercase tracking-wider ${accentTextClass}`}>
      Découvrir →
    </span>
  </div>
</a>
