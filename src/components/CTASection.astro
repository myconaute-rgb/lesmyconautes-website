---
interface Props {
  title?: string;
  description?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  /** "editorial" = DA refonte accueil 07/2026 (maquette 9). Défaut : rendu historique. */
  variant?: "v1" | "editorial";
}

const {
  title = "Prêt·e à goûter ?",
  description = "Commandez en ligne sur Pour de Bon, ou contactez-nous pour les volumes pro.",
  primaryCta = { href: "https://www.pourdebon.com/les-myconautes-s1527", label: "Commander en ligne" },
  secondaryCta = { href: "/contact", label: "Nous écrire" },
  variant = "v1",
} = Astro.props;
const editorial = variant === "editorial";
---

{editorial ? (
  <section class="bg-page font-body px-6 md:px-10 py-24 md:py-32">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-title text-[clamp(2.4rem,5.5vw,4.5rem)] leading-[1.02] text-violet">
        {title.split(" ").slice(0, -2).join(" ")}<em class="italic">{" " + title.split(" ").slice(-2).join(" ")}</em>
      </h2>
      <p class="mt-6 text-brun leading-relaxed max-w-md mx-auto">{description}</p>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a
          href={primaryCta.href}
          target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
          rel={primaryCta.href.startsWith("http") ? "noopener" : undefined}
          class="inline-flex items-center px-8 py-4 rounded-btn bg-violet text-page text-sm font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex items-center px-8 py-4 rounded-btn border-2 border-violet text-violet text-sm font-semibold tracking-wide uppercase hover:bg-violet/10 transition-colors"
        >
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </section>
) : (
  <section class="bg-brun text-ivoire px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl text-ivoire">{title}</h2>
      <p class="mt-4 text-ivoire/70 leading-relaxed">{description}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={primaryCta.href}
          target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
          rel={primaryCta.href.startsWith("http") ? "noopener" : undefined}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-terracotta text-ivoire font-semibold hover:brightness-110 transition shadow-sm"
        >
          {primaryCta.label} <span aria-hidden="true">→</span>
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full border-2 border-ivoire/40 text-ivoire font-semibold hover:bg-ivoire/10 transition"
        >
          {secondaryCta.label}
        </a>
      </div>
    </div>
  </section>
)}
