---
/** Étape « livraison & retrait » — maquette-corps-page-accueil (brief V2 16/07).
 *  Icône violette en bulle (extraite de la maquette), titre Anton violet. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  icon: ImageMetadata;
  title: string;
}

const { icon, title } = Astro.props;
---

<div class="text-center font-body">
  <Image
    src={icon}
    alt=""
    loading="lazy"
    decoding="async"
    widths={[160, 300]}
    sizes="160px"
    formats={["avif", "webp"]}
    class="w-36 mx-auto"
  />
  <h3 class="mt-4 font-title text-2xl text-violet">{title}</h3>
  <div class="mt-3 text-sm text-brun leading-relaxed max-w-xs mx-auto">
    <slot />
  </div>
</div>
