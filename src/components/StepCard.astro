---
/** Étape « comment ça marche » — DA refonte 07/2026 (maquette 6). */
interface Props {
  number: number;
  title: string;
  /** Conservé pour compat d'appel ; la DA refonte est monochrome violet. */
  color?: "turquoise" | "lavande" | "terracotta";
}

const { number, title } = Astro.props;
---

<div class="text-center font-body">
  <div class="w-24 h-24 mx-auto rounded-full bg-violet text-page font-title text-4xl flex items-center justify-center">
    {number}
  </div>
  <h3 class="mt-7 font-title text-2xl text-violet">{title}</h3>
  <div class="mt-3 text-sm text-brun leading-relaxed max-w-xs mx-auto">
    <slot />
  </div>
</div>
