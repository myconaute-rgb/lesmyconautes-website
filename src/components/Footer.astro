---
/**
 * Pied de page commun — maquette-bas-de-pageV1 (brief V2 16/07).
 * Identique sur toutes les pages. Les liens existants ne changent pas
 * (destinations identiques ; /pros et /myconautes = renommages d'URL).
 */
const year = new Date().getFullYear();
const colTitleClass = "font-title text-lg tracking-wide text-page mb-4";
const linkClass = "hover:text-page underline-offset-4 hover:underline transition";
---

<footer class="theme-refonte bg-violet text-page/90 font-body px-6 md:px-10 pt-16 pb-8">
  <div class="max-w-7xl mx-auto grid gap-10 md:grid-cols-[auto_2fr_1fr_1fr_1fr] items-start">
    <span class="flex items-center justify-center h-24 w-24 rounded-full bg-blanc">
      <img src="/logo-myconautes.png" alt="Les Myconautes" width="88" height="88" class="h-22 w-22" />
    </span>

    <p class="text-base leading-relaxed max-w-sm">
      Champignonnière artisanale certifiée bio. Champignons cultivés, récoltés à la main et conditionnés à Rive-de-Gier (Loire). Producteur direct, sans intermédiaire.
    </p>

    <div>
      <h4 class={`${colTitleClass} font-title`}>Je suis ?</h4>
      <ul class="space-y-2 text-base">
        <li><a href="/particuliers" class={linkClass}>Particulier</a></li>
        <li><a href="/pros" class={linkClass}>Pro</a></li>
        <li><a href="/agriculteurs" class={linkClass}>Agriculteur</a></li>
        <li><a href="/myconautes" class={linkClass}>Myconaute</a></li>
      </ul>
    </div>

    <div>
      <h4 class={`${colTitleClass} font-title`}>Je commande :</h4>
      <ul class="space-y-2 text-base">
        <li><a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class={linkClass}>Pour de Bon</a></li>
        <li><a href="/contact" class={linkClass}>Contact</a></li>
      </ul>
    </div>

    <div>
      <h4 class={`${colTitleClass} font-title`}>J'explore :</h4>
      <ul class="space-y-2 text-base">
        <li><a href="https://www.instagram.com/les_myconautes/" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-page transition">Instagram</a></li>
        <li><a href="https://www.facebook.com/p/Les-Myconautes-61577873314539/" target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-page transition">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto mt-12 flex flex-col md:flex-row justify-between gap-2 text-sm text-page/90">
    <span>© {year} Les Myconautes - SCEA GRANGE CHAMPIGNONS</span>
    <div class="flex gap-6">
      <a href="/mentions-legales" class="hover:text-page transition">Mentions légales</a>
      <a href="/politique-confidentialite" class="hover:text-page transition">Confidentialité</a>
      <a href="/cgv" class="hover:text-page transition">CGV</a>
    </div>
  </div>
</footer>
