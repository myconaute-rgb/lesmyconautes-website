---
/**
 * Haut de page commun — maquette-haut-de-pageV1 (brief V2 16/07).
 * Identique sur toutes les pages : logo rond seul (sans « Les Myconautes »
 * en toutes lettres), onglets Particuliers · Pros · Agriculteurs · Myconautes,
 * bouton Commander violet. La classe theme-refonte scope les règles typo DA.
 */
import { Image } from "astro:assets";
import emblemePic from "../assets/logos/embleme-myconautes.png";

const links = [
  { href: "/particuliers", label: "Particuliers" },
  { href: "/pros", label: "Pros" },
  { href: "/agriculteurs", label: "Agriculteurs" },
  { href: "/myconautes", label: "Myconautes" },
];
const orderHref = "https://www.pourdebon.com/les-myconautes-s1527";
---

<nav class="theme-refonte sticky top-0 z-50 bg-page/95 backdrop-blur-sm font-body">
  <div class="max-w-7xl mx-auto px-6 md:px-10 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center text-brun" aria-label="Les Myconautes — accueil">
      <Image
        src={emblemePic}
        alt="Les Myconautes"
        loading="eager"
        widths={[56, 112, 168]}
        sizes="56px"
        formats={["avif", "webp"]}
        class="h-14 w-14"
      />
    </a>

    <ul class="hidden md:flex items-center gap-10">
      {links.map((l) => (
        <li>
          <a href={l.href} class="font-body text-sm font-medium tracking-wide uppercase text-brun hover:text-violet transition-colors">
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={orderHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center px-6 py-3 rounded-btn bg-violet text-page font-body text-sm font-semibold tracking-wide uppercase hover:bg-violet/90 transition-colors"
        >
          Commander
        </a>
      </li>
    </ul>

    <button
      type="button"
      class="md:hidden p-2 -mr-2 text-brun"
      aria-label="Ouvrir le menu"
      data-mobile-toggle
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>
</nav>

<div
  class="theme-refonte md:hidden fixed inset-0 z-[60] bg-page flex-col items-center justify-center gap-6 hidden font-body"
  data-mobile-menu
>
  <button
    type="button"
    class="absolute top-4 right-4 p-2 text-brun"
    aria-label="Fermer le menu"
    data-mobile-close
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M6 18L18 6" />
    </svg>
  </button>
  {links.map((l) => (
    <a href={l.href} class="font-title text-3xl text-violet uppercase">{l.label}</a>
  ))}
  <a
    href={orderHref}
    target="_blank"
    rel="noopener"
    class="mt-4 px-8 py-4 rounded-btn bg-violet text-page font-body text-sm font-semibold tracking-wide uppercase"
  >
    Commander
  </a>
</div>

<script>
  const toggle = document.querySelector("[data-mobile-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const close = document.querySelector("[data-mobile-close]");
  const open = () => menu?.classList.replace("hidden", "flex");
  const shut = () => menu?.classList.replace("flex", "hidden");
  toggle?.addEventListener("click", open);
  close?.addEventListener("click", shut);
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", shut));
</script>
