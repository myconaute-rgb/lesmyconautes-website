---
interface Props {
  /** Min de commande à afficher dans les cards Lyon/St-É (ex: "25€" pour particuliers). */
  minOrder?: string;
  /** Override du fond de section ; par défaut crème. */
  background?: "creme" | "ivoire";
  /** "editorial" = DA refonte accueil 07/2026 (maquette 6). Défaut : rendu historique. */
  variant?: "v1" | "editorial";
  /** Tarif de la tournée Lyon / Saint-Étienne. 3,50 € sur /particuliers depuis
   *  le patch DA du 25/07 ; 4,20 € partout ailleurs. */
  deliveryPrice?: string;
}

const { minOrder, background = "creme", variant = "v1", deliveryPrice = "4,20€" } = Astro.props;
const editorial = variant === "editorial";
const sectionBg = background === "creme" ? "bg-creme" : "bg-ivoire";
const cardBg = background === "creme" ? "bg-ivoire" : "bg-creme";
---

{editorial ? (
  <div class="grid md:grid-cols-3 gap-6 font-body">
    <div class="bg-lilas p-8 flex flex-col">
      <h3 class="font-title text-xl text-cacao">Retrait sur place</h3>
      <p class="mt-5 text-sm text-brun leading-relaxed">
        5 rue Vallée de Couzon<br/>42800 Rive-de-Gier
      </p>
      <p class="mt-5 text-sm text-brun leading-relaxed">
        Lundi au vendredi<br/>De 7h à 13h
      </p>
      <div class="mt-auto pt-8 font-title text-lg text-cacao">Gratuit</div>
    </div>

    <div class="bg-lilas p-8 flex flex-col">
      <h3 class="font-title text-xl text-cacao">Livraison direct producteur</h3>
      <p class="mt-5 font-title text-base text-cacao">A Lyon</p>
      <p class="text-sm text-brun leading-relaxed">Tous les vendredis<br/>Entre 8h et 12h</p>
      <p class="mt-4 font-title text-base text-cacao">A Saint-Etienne</p>
      <p class="text-sm text-brun leading-relaxed">Tous les jeudis<br/>Entre 8h et 12h</p>
      <div class="mt-auto pt-8 font-title text-lg text-cacao">{deliveryPrice}</div>
    </div>

    <div class="bg-lilas p-8 flex flex-col">
      <h3 class="font-title text-xl text-cacao">Partout en France</h3>
      <p class="mt-5 font-title text-base text-cacao">Via Pour de Bon</p>
      <p class="mt-2 text-sm text-brun leading-relaxed">
        Nous recevons et préparons directement votre commande.
      </p>
      <p class="mt-4 text-sm text-brun leading-relaxed">
        Vous êtes livrés par Chronofresh quand vous voulez, que vous soyez un particulier ou un professionnel.
      </p>
      <div class="mt-auto pt-8 font-title text-lg text-cacao">
        <a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class="hover:underline underline-offset-4">Voir les tarifs</a>
      </div>
    </div>
  </div>
) : (
  <section id="livraison" class={`${sectionBg} px-6 py-20`}>
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-semibold tracking-widest uppercase text-terracotta">Livraison</span>
        <h2 class="mt-2 text-3xl md:text-4xl text-brun">Comment recevoir vos champignons</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class={`${cardBg} rounded-2xl p-6 text-center ring-1 ring-brun/5`}>
          <div class="text-3xl mb-3" aria-hidden="true">📦</div>
          <h3 class="text-base text-brun">Retrait sur place</h3>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed">
            5 rue Vallée de Couzon<br/>42800 Rive-de-Gier<br/>Lun – Ven, 7h à 13h
          </p>
          <div class="mt-3 inline-block text-turquoise font-semibold text-sm">Gratuit</div>
        </div>

        <div class={`${cardBg} rounded-2xl p-6 text-center ring-1 ring-brun/5`}>
          <div class="text-3xl mb-3" aria-hidden="true">🚛</div>
          <h3 class="text-base text-brun">Livraison Lyon</h3>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed">
            Vendredi 8h – 12h<br/>Rayon 5 km{minOrder && <><br/>Min. {minOrder}</>}
          </p>
          <div class="mt-3 inline-block text-terracotta font-semibold text-sm">2,00 €</div>
        </div>

        <div class={`${cardBg} rounded-2xl p-6 text-center ring-1 ring-brun/5`}>
          <div class="text-3xl mb-3" aria-hidden="true">🚛</div>
          <h3 class="text-base text-brun">Livraison Saint-Étienne</h3>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed">
            Jeudi 8h – 12h<br/>Rayon 5 km{minOrder && <><br/>Min. {minOrder}</>}
          </p>
          <div class="mt-3 inline-block text-terracotta font-semibold text-sm">2,00 €</div>
        </div>

        <div class={`${cardBg} rounded-2xl p-6 text-center ring-1 ring-brun/5`}>
          <div class="text-3xl mb-3" aria-hidden="true">📬</div>
          <h3 class="text-base text-brun">Partout en France</h3>
          <p class="mt-2 text-sm text-brun-clair leading-relaxed">
            Via <a href="https://www.pourdebon.com/les-myconautes-s1527" target="_blank" rel="noopener" class="text-violet-profond font-semibold hover:underline">Pour de Bon</a>
          </p>
          <div class="mt-3 inline-block text-violet-profond font-semibold text-sm">Voir tarifs</div>
        </div>
      </div>
    </div>
  </section>
)}
