---
/**
 * Schéma Product — pages substrat money.
 *
 * Décision business validée : pas de bloc `offers` (stratégie grille
 * tarifaire pro téléchargeable, prix non public).
 *
 * Usage :
 *   <ProductLd
 *     slug="substrat-pleurote-pro"
 *     name="Substrat de pleurote professionnel bio"
 *     description="..."
 *     image="/photos/agri-pleurote.jpg"
 *     latinName="Pleurotus ostreatus"
 *     properties={[
 *       { name: "Phase", value: "Phase IV active" },
 *       ...
 *     ]}
 *   />
 */

import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import JsonLd from "./JsonLd.astro";
import { ORG, ORG_ID } from "../../data/organization";

interface Property {
  name: string;
  value: string;
}

interface Props {
  slug: string; // sans slash, ex: "substrat-pleurote-pro"
  name: string;
  description: string;
  /** Image typée Astro (auto AVIF/WebP) OU URL absolue string. Le composant résout
   *  l'URL absolue côté JSON-LD pour que les crawlers puissent fetcher l'image. */
  image?: ImageMetadata | string;
  latinName?: string;
  properties: Property[];
}

const { slug, name, description, image, latinName, properties } = Astro.props;

const productId = `${ORG.url}/${slug}/#product`;

let imageUrl: string | undefined;
if (image) {
  if (typeof image === "string") {
    imageUrl = image.startsWith("http") ? image : `${ORG.url}${image}`;
  } else {
    // ImageMetadata — résout l'URL absolue de l'image (originale, hashée par Astro)
    const resolved = await getImage({ src: image, format: "webp", width: 1200 });
    imageUrl = resolved.src.startsWith("http") ? resolved.src : `${ORG.url}${resolved.src}`;
  }
}

const allProperties: Property[] = [
  ...(latinName ? [{ name: "Variété", value: latinName }] : []),
  ...properties,
  { name: "Certification", value: `${ORG.certification.label} (${ORG.certification.body})` },
  {
    name: "Origine",
    value: `France — ${ORG.productionAddress.addressLocality} (${ORG.productionAddress.postalCode})`,
  },
];

const data: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": productId,
  name,
  description,
  brand: {
    "@type": "Brand",
    name: ORG.brandName,
  },
  manufacturer: {
    "@id": ORG_ID,
  },
  category: "Substrat de champignon professionnel",
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Myciculteurs professionnels",
  },
  additionalProperty: allProperties.map((p) => ({
    "@type": "PropertyValue",
    name: p.name,
    value: p.value,
  })),
};

if (imageUrl) {
  data.image = imageUrl;
}
---

<JsonLd data={data} />
