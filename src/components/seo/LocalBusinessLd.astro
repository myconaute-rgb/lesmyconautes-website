---
/**
 * Schéma LocalBusiness (qui hérite d'Organization).
 *
 * À placer sur la page d'accueil et la page contact uniquement.
 * Les autres pages référencent cette entité via `@id` partagé.
 *
 * Pas de telephone / openingHours pour l'instant (en attente décision Florestan).
 * Pas de sameAs pour l'instant (réseaux sociaux pas encore prêts en business).
 */

import JsonLd from "./JsonLd.astro";
import { ORG, ORG_ID } from "../../data/organization";

const data = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": ORG_ID,
  name: ORG.brandName,
  legalName: ORG.legalName,
  url: ORG.url,
  logo: ORG.logo,
  description:
    "Producteur français de substrat de champignons gourmets bio certifié FR-BIO-01. Spécialiste du pleurote, eryngii et hericium pour myciculteurs professionnels.",
  email: ORG.email,
  vatID: ORG.vatId,
  taxID: ORG.siret,
  founder: {
    "@type": "Person",
    name: ORG.founder,
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: ORG.headquartersAddress.streetAddress,
    postalCode: ORG.headquartersAddress.postalCode,
    addressLocality: ORG.headquartersAddress.addressLocality,
    addressRegion: ORG.headquartersAddress.addressRegion,
    addressCountry: ORG.headquartersAddress.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: ORG.geo.latitude,
    longitude: ORG.geo.longitude,
  },
  areaServed: {
    "@type": "Country",
    name: "France",
  },
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "Certification biologique",
    name: ORG.certification.label,
    recognizedBy: {
      "@type": "Organization",
      name: ORG.certification.body,
    },
    identifier: ORG.certification.number,
  },
  knowsAbout: ORG.knowsAbout,
};
---

<JsonLd data={data} />
