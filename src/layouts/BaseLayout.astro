---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/fraunces/wght-italic.css";
import "@fontsource-variable/outfit";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  /** "refonte" = peau DA accueil 07/2026 pour Nav/Footer. Défaut : peau historique. */
  skin?: "v1" | "refonte";
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  skin = "v1",
  description = "Champignons bio cultivés à Rive-de-Gier (Loire). Pleurote, shiitaké, éryngii, hericium. Pour la cuisine maison, la restauration et la production agricole.",
  ogImage = "/scaphandre-logo.svg",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://lesmyconautes.fr").toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class={`bg-ivoire text-brun antialiased${skin === "refonte" ? " theme-refonte" : ""}`}>
    <Nav skin={skin} />
    <main>
      <slot />
    </main>
    <Footer skin={skin} />
  </body>
</html>
